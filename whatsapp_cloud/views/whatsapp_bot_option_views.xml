<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="whatsapp_bot_option_view_form" model="ir.ui.view">
        <field name="name">whatsapp.bot.option.form</field>
        <field name="model">whatsapp.bot.option</field>
        <field name="arch" type="xml">
            <form string="Menu Option">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Our stores"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="action"/>
                            <field name="lang" invisible="action != 'lang'" required="action == 'lang'"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="account_id" readonly="1"/>
                            <field name="parent_id" readonly="1" invisible="not parent_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <div class="text-muted mb-3" name="action_help">
                        <span invisible="action != 'text'">Sends the answer below.</span>
                        <span invisible="action != 'submenu'">Sends the text below with the options of the
                            sub-menu and a "Main menu" choice (9 options at most).</span>
                        <span invisible="action != 'lang'">The customer then receives the answers, the menus and
                            the notifications in this language. Not offered to the customers who already use it.</span>
                        <span invisible="action not in ('stop', 'start')">The customer stops, or receives again,
                            the WhatsApp notifications (as with STOP and START): only the useful option is offered.</span>
                        <span invisible="action != 'handover'">The conversation goes to the team.</span>
                    </div>
                    <group invisible="action not in ('text', 'submenu')">
                        <field name="answer" required="action == 'text'"
                               placeholder="For a sub-menu: the text above its options"/>
                    </group>
                    <separator string="Options of the Sub-menu" invisible="action != 'submenu'"/>
                    <field name="child_ids" invisible="action != 'submenu'">
                        <list editable="bottom" decoration-muted="not active">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="description" optional="show"/>
                            <field name="action"/>
                            <field name="answer" invisible="action != 'text'" required="action == 'text'"/>
                            <field name="lang" invisible="action != 'lang'" required="action == 'lang'"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
