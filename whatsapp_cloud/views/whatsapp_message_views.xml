<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="whatsapp_message_view_list" model="ir.ui.view">
        <field name="name">whatsapp.message.list</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <list create="False">
                <field name="create_date" string="Date"/>
                <field name="direction"/>
                <field name="message_type" optional="show"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="template_id"/>
                <field name="record_name"/>
                <field name="body" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'queued'"
                       decoration-success="state in ('delivered', 'read', 'received')"
                       decoration-muted="state == 'skipped'" decoration-danger="state == 'failed'"/>
                <field name="error" optional="show"/>
                <field name="error_help" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_message_view_search" model="ir.ui.view">
        <field name="name">whatsapp.message.search</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="template_id"/>
                <filter name="outgoing" string="Sent" domain="[('direction', '=', 'outgoing')]"/>
                <filter name="incoming" string="Received" domain="[('direction', '=', 'incoming')]"/>
                <separator/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="skipped" string="Not sent" domain="[('state', '=', 'skipped')]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'message_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="whatsapp_message_view_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form create="False" edit="False">
                <header>
                    <button name="action_retry" type="object" string="Send Again"
                            invisible="state != 'failed' or direction != 'outgoing'" groups="whatsapp_cloud.group_whatsapp_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,sent,delivered,read"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_record" type="object" class="oe_stat_button"
                                icon="fa-file-o" invisible="not res_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Document</span>
                                <span class="o_stat_text"><field name="record_name"/></span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="message_type"/>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="user_ref" invisible="not user_ref"/>
                            <field name="channel_id" invisible="not channel_id"/>
                            <field name="parent_id" invisible="not parent_id"/>
                            <field name="template_id"/>
                            <field name="account_id"/>
                            <field name="model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="create_date" string="Created on"/>
                            <field name="sent_date"/>
                            <field name="delivered_date"/>
                            <field name="read_date"/>
                            <field name="attempts"/>
                            <field name="wa_message_id"/>
                            <field name="pricing_category" invisible="not pricing_category"/>
                        </group>
                    </group>
                    <field name="body" nolabel="1"/>
                    <group invisible="not error">
                        <field name="error" class="text-danger"/>
                        <field name="error_help" invisible="not error_help"/>
                    </group>
                    <group invisible="not attachment_id">
                        <field name="attachment_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_message_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Messages</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No WhatsApp message yet</p>
            <p>The messages sent by the automation rules and the "Send WhatsApp" buttons, and the
               replies of the customers, appear here with their status.</p>
        </field>
    </record>

</odoo>
