<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WhatsApp" string="WhatsApp" name="whatsapp_cloud"
                     groups="whatsapp_cloud.group_whatsapp_manager">
                    <block title="WhatsApp Accounts" name="whatsapp_accounts">
                        <setting id="whatsapp_accounts_setting"
                                 help="WhatsApp Business numbers connected with the Cloud API of Meta: identifiers, access token, team, opening hours and texts of the automatic answers.">
                            <div class="w-50">
                                <field name="whatsapp_account_count" class="w-auto ps-1 pe-1 fw-bold"/>
                                <span class="o_form_label" invisible="whatsapp_account_count &gt; 1">Account</span>
                                <span class="o_form_label" invisible="whatsapp_account_count &lt;= 1">Accounts</span>
                            </div>
                            <div class="mt8">
                                <button name="action_open_whatsapp_accounts" type="object" string="Manage the Accounts"
                                        icon="east" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Conversations" name="whatsapp_conversations">
                        <setting help="The messages of the customers arrive in Discuss (WhatsApp tab), where the team answers them. Disabled: they are only noted on the contacts, without answer.">
                            <field name="whatsapp_conversations"/>
                        </setting>
                        <setting help="The customers see the blue ticks when an agent reads their message, and &quot;typing...&quot; while the agent writes."
                                 invisible="not whatsapp_conversations">
                            <field name="whatsapp_read_receipts"/>
                        </setting>
                        <setting help="The agents are reminded of the messages waiting for an answer, then the managers are alerted (delays of the WhatsApp account)."
                                 invisible="not whatsapp_conversations">
                            <field name="whatsapp_answer_reminders"/>
                        </setting>
                    </block>
                    <block title="Automatic Answers" name="whatsapp_automatic_answers" invisible="not whatsapp_conversations">
                        <setting help="A new conversation starts with the welcome message and the options of the menu (texts and options on the account).">
                            <field name="whatsapp_welcome_menu"/>
                        </setting>
                        <setting help="Sent outside of the opening hours of the account, at most once every 12 hours to a customer.">
                            <field name="whatsapp_away_message"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="whatsapp_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'whatsapp_cloud'}</field>
    </record>

</odoo>
