<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_send_queued_messages" model="ir.cron" forcecreate="True">
            <field name="name">WhatsApp: send the queued messages</field>
            <field name="model_id" ref="model_whatsapp_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_queued()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>
        <record id="ir_cron_process_webhook_events" model="ir.cron" forcecreate="True">
            <field name="name">WhatsApp: process the notifications of Meta</field>
            <field name="model_id" ref="model_whatsapp_webhook_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>
        <record id="ir_cron_check_answer_delays" model="ir.cron" forcecreate="True">
            <field name="name">WhatsApp: remind the conversations waiting for an answer</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="state">code</field>
            <field name="code">model._cron_whatsapp_check_delays()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>
        <!-- Without the webhook of the templates, the only way to know the review of Meta -->
        <record id="ir_cron_read_pending_templates" model="ir.cron" forcecreate="True">
            <field name="name">WhatsApp: read the templates waiting for Meta</field>
            <field name="model_id" ref="model_whatsapp_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_read_pending_from_meta()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
        </record>
        <record id="ir_cron_check_health" model="ir.cron" forcecreate="True">
            <field name="name">WhatsApp: check the accounts at Meta</field>
            <field name="model_id" ref="model_whatsapp_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_health()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
</odoo>
