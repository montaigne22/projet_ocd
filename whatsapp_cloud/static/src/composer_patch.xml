<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- more than 24 hours after the last message of the customer: the composer writes internal
         notes (in yellow, like the notes) -->
    <t t-inherit="mail.Composer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Composer')]" position="attributes">
            <attribute name="t-att-data-whatsapp-note">this.thread?.channel?.whatsappNoteOnly ? 'true' : undefined</attribute>
        </xpath>
        <!-- the window closed: why, and the button that writes to the customer, above the composer -->
        <xpath expr="//div[hasclass('o-mail-Composer-coreHeader')]" position="inside">
            <div t-if="this.thread?.channel?.whatsappNoteOnly and !this.props.composer.message and this.store.self_user?.share === false"
                 class="o-whatsapp-ComposerWindow d-flex flex-wrap align-items-center gap-2 px-2 py-1 mb-1 rounded-3 small">
                <span class="flex-grow-1">More than 24 hours since the last message of the customer: only a template reaches them. Below: an internal note for the team.</span>
                <button type="button" class="o-whatsapp-ComposerWindow-send btn btn-sm btn-primary text-nowrap"
                        t-on-click="() => this.onClickWhatsappTemplate()">
                    <i class="oi me-1" data-icon="oi_whatsapp" aria-hidden="true"/>Send a template
                </button>
            </div>
        </xpath>
    </t>
</templates>
