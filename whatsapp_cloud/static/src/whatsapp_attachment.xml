<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="whatsapp_cloud.WhatsAppAttachment">
        <div class="o-whatsapp-Attachment w-100" t-att-data-kind="this.kind" t-on-click.stop="() => {}">
            <!-- a sound: a small player, like a voice message of WhatsApp -->
            <t t-if="this.kind === 'audio'">
                <div class="o-whatsapp-Audio d-flex align-items-center gap-2 px-2 py-1">
                    <button type="button" class="o-whatsapp-Audio-play btn btn-light rounded-circle oi flex-shrink-0"
                            t-att-data-icon="this.state.playing ? 'pause' : 'play_arrow'"
                            t-att-title="this.playTitle" t-att-aria-label="this.playTitle"
                            t-att-disabled="this.state.error" t-on-click="() => this.togglePlay()"/>
                    <div class="flex-grow-1 min-w-0">
                        <input type="range" class="o-whatsapp-Audio-seek form-range d-block" min="0" step="0.1"
                               t-att-max="this.state.duration || 0" t-att-value="this.state.current"
                               t-att-disabled="this.state.error or !this.state.duration"
                               t-att-aria-label="this.attachment.name" t-on-input="this.onSeek"/>
                        <div class="d-flex justify-content-between small text-muted lh-1">
                            <span class="o-whatsapp-Audio-time" t-out="this.timeLabel"/>
                            <span t-if="this.state.error" class="text-danger">Cannot be played here: download it</span>
                        </div>
                    </div>
                    <button type="button" class="o-whatsapp-Audio-rate btn btn-sm btn-light rounded-pill px-2 flex-shrink-0"
                            t-att-disabled="this.state.error" t-on-click="() => this.cycleRate()" t-out="this.rateLabel"/>
                    <a class="o-whatsapp-Attachment-download btn btn-sm btn-link oi flex-shrink-0" data-icon="download"
                       t-att-href="this.downloadUrl" download="" title="Download" aria-label="Download"/>
                    <audio t-ref="this.media" preload="metadata" t-att-src="this.src"
                           t-on-loadedmetadata="() => this.onLoadedMetadata()" t-on-timeupdate="() => this.onTimeUpdate()"
                           t-on-play="() => this.onPlay()" t-on-pause="() => this.onPause()"
                           t-on-ended="() => this.onEnded()" t-on-error="() => this.onError()"/>
                </div>
            </t>
            <!-- a video: played in place -->
            <t t-elif="this.kind === 'video'">
                <div class="o-whatsapp-Video">
                    <video t-ref="this.media" class="o-whatsapp-Video-player d-block w-100 rounded-top-3 bg-black" controls="controls"
                           preload="metadata" playsinline="playsinline" t-att-poster="this.poster" t-att-src="this.src"
                           t-on-error="() => this.onError()"/>
                    <div class="d-flex align-items-center gap-2 px-2 py-1 small">
                        <span class="text-truncate flex-grow-1" t-out="this.attachment.name"/>
                        <span t-if="this.state.error" class="text-danger text-nowrap">Cannot be played here</span>
                        <span t-elif="this.sizeLabel" class="text-muted text-nowrap" t-out="this.sizeLabel"/>
                        <a class="o-whatsapp-Attachment-download btn btn-sm btn-link oi p-0" data-icon="download"
                           t-att-href="this.downloadUrl" download="" title="Download" aria-label="Download"/>
                    </div>
                </div>
            </t>
            <!-- a document: a line, opened in the viewer of Odoo when it can -->
            <t t-else="">
                <div class="o-whatsapp-Document d-flex align-items-center gap-2 px-2 py-2 cursor-pointer"
                     role="button" tabindex="0" t-att-title="this.attachment.name"
                     t-on-click="() => this.onClickDocument()" t-on-keydown="(ev) => this.onKeydownDocument(ev)">
                    <div class="o-whatsapp-Document-icon o_image flex-shrink-0" t-att-data-mimetype="this.attachment.mimetype"/>
                    <div class="flex-grow-1 min-w-0">
                        <div class="o-whatsapp-Document-name fw-bold text-break" t-out="this.attachment.name"/>
                        <div class="small text-muted">
                            <t t-out="this.typeLabel"/><t t-if="this.sizeLabel"> · <t t-out="this.sizeLabel"/></t>
                        </div>
                    </div>
                    <a class="o-whatsapp-Attachment-download btn btn-sm btn-link oi flex-shrink-0" data-icon="download"
                       t-att-href="this.downloadUrl" download="" title="Download" aria-label="Download"
                       t-on-click.stop="() => {}"/>
                </div>
            </t>
        </div>
    </t>
</templates>
