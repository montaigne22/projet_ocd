<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="whatsapp_cloud.WindowChip">
        <t t-set="left" t-value="this.left()"/>
        <span t-if="left" class="o-whatsapp-WindowChip badge rounded-pill fw-normal text-nowrap"
              t-att-class="{ 'o-whatsapp-WindowChip-urgent': left.urgent }"
              t-att-title="left.tooltip" t-att-data-tooltip="left.tooltip">
            <i class="oi me-1" data-icon="schedule" aria-hidden="true"/><t t-out="this.props.compact ? left.short : left.text"/>
        </span>
        <span t-elif="this.props.showClosed" class="o-whatsapp-WindowChip o-whatsapp-WindowChip-closed badge rounded-pill fw-normal text-nowrap"
              title="More than 24 hours since the last message of the customer: only a paid template reaches them.">
            <i class="oi me-1" data-icon="schedule" aria-hidden="true"/>24 h passed
        </span>
    </t>

    <!-- In the header of a WhatsApp conversation (Discuss), next to the name of the customer -->
    <t t-inherit="mail.DiscussContent" t-inherit-mode="extension">
        <xpath expr="//AutoresizeInput[contains(@inputClassName, 'o-mail-DiscussContent-threadName')]" position="after">
            <WhatsappWindowChip t-if="this.thread.channel?.isWhatsApp and this.store.self_user?.share === false"
                                t-key="this.thread.localId" channel="this.thread.channel" showClosed="true"/>
        </xpath>
    </t>

    <!-- In the header of a chat window (the conversations on a phone, the chat bubbles) -->
    <t t-inherit="mail.ChatWindow.headerContent" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-ChatWindow-nameBox')]" position="after">
            <WhatsappWindowChip t-if="this.channel?.isWhatsApp and this.store.self_user?.share === false"
                                t-key="this.channel.localId" channel="this.channel" compact="true" showClosed="true"/>
        </xpath>
    </t>

    <!-- In the list of the conversations: the customers who wait for an answer -->
    <t t-inherit="mail.MessagingMenuItem" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='name-after']" position="inside">
            <WhatsappWindowChip t-if="this.channel?.isWhatsApp and this.channel.whatsapp_waiting_since and this.store.self_user?.share === false"
                                channel="this.channel" compact="true"/>
        </xpath>
    </t>
</templates>
