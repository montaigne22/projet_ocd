<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="whatsapp_composer_view_form" model="ir.ui.view">
        <field name="name">whatsapp.composer.form</field>
        <field name="model">whatsapp.composer</field>
        <field name="arch" type="xml">
            <form>
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not warning">
                    <field name="warning"/>
                </div>
                <group>
                    <field name="recipient" string="To"/>
                    <field name="template_id" options="{'no_create': True}"/>
                </group>
                <field name="preview" class="text-muted"/>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"
                            data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
