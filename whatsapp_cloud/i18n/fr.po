#: model_terms:ir.ui.view,arch_db:whatsapp_cloud.whatsapp_bot_option_view_form
msgid ""
"<span invisible=\"action != 'text'\">Sends the answer below.</span>\n"
"                        <span invisible=\"action != 'submenu'\">Sends the text below with the options of the\n"
"                            sub-menu and a \"Main menu\" choice (9 options at most).</span>\n"
"                        <span invisible=\"action != 'lang'\">The customer then receives the answers, the menus and\n"
"                            the notifications in this language. Not offered to the customers who already use it.</span>\n"
"                        <span invisible=\"action not in ('stop', 'start')\">The customer stops, or receives again,\n"
"                            the WhatsApp notifications (as with STOP and START): only the useful option is offered.</span>\n"
"                        <span invisible=\"action != 'handover'\">The conversation goes to the team.</span>"
msgstr ""
"<span invisible=\"action != 'text'\">Envoie la réponse ci-dessous.</span> "
"<span invisible=\"action != 'submenu'\">Envoie le texte ci-dessous avec les "
"options du sous-menu et un choix « Menu principal » (9 options au "
"plus).</span> <span invisible=\"action != 'lang'\">Le client reçoit ensuite "
"les réponses, les menus et les notifications dans cette langue. Non proposée"
" aux clients qui l’utilisent déjà.</span> <span invisible=\"action not in "
"('stop', 'start')\">Le client arrête, ou reçoit à nouveau, les notifications"
" WhatsApp (comme avec STOP et START) : seule l’option utile est "
"proposée.</span> <span invisible=\"action != 'handover'\">La conversation "
"passe à l’équipe.</span>"

