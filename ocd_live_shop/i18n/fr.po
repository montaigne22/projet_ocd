msgid "<i class=\"o_ocd_onair_dot\" aria-hidden=\"true\"/>Seen in a live on OCD"
msgstr "<i class=\"o_ocd_onair_dot\" aria-hidden=\"true\"/>Vu en live sur OCD"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.product
msgid "<i class=\"o_ocd_onair_dot\" aria-hidden=\"true\"/>Seen in a live on OCD · watch the moment"
msgstr "<i class=\"o_ocd_onair_dot\" aria-hidden=\"true\"/>Vu en live sur OCD · voir le moment"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_figures
msgid "<small class=\"o_ocd_figures_muted\">When your customers order, at your hour.</small>"
msgstr "<small class=\"o_ocd_figures_muted\">Quand tes clients commandent, à ton heure.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_figures
msgid "<small class=\"o_ocd_figures_muted\">Your sales, the visits of your boutique and your best seller of the week.</small>"
msgstr "<small class=\"o_ocd_figures_muted\">Tes ventes, les visites de ta boutique et ton produit le plus vendu de la semaine.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_places
msgid "<small class=\"o_ocd_my_product_fact\">My store is a relay point: it keeps the parcels of the customers of the other vendors, paid for each parcel handed over.</small>"
msgstr "<small class=\"o_ocd_my_product_fact\">Mon magasin est un point relais : il garde les colis des clients des autres vendeurs, payé pour chaque colis remis.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_product_edit
msgid "<small class=\"o_ocd_parcel_hint\">A size or a colour is not removed: at 0 piece, it shows « Sold out ». A colour added waits for its photo.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">Une taille ou une couleur ne se retire pas : à 0 pièce, elle s'affiche « Épuisé ». Une couleur ajoutée attend sa photo.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_stock
msgid "<small class=\"o_ocd_parcel_hint\">At 0 in all your stores, the size stays visible with « Sold out »; the customers who ask are told when it is back.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">À 0 dans tous tes magasins, la taille reste visible avec « Épuisé » ; les clients qui le demandent sont prévenus à son retour.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_products
msgid "<small class=\"o_ocd_parcel_hint\">At 0, the product stays visible with “Sold out”. Put a quantity back when you have some.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">À 0, le produit reste visible avec « Épuisé ». Remets une quantité quand tu en as.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_place_form
msgid "<small class=\"o_ocd_parcel_hint\">Empty: your number.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">Vide : ton numéro.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_labels
msgid "<small class=\"o_ocd_parcel_hint\">On a phone: Print, then choose a printer or “Save as PDF” to send it to a print shop.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">Sur un téléphone : Imprimer, puis choisis une imprimante ou « Enregistrer en PDF » pour l'envoyer à un imprimeur.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_team
msgid "<small class=\"o_ocd_parcel_hint\">She opens her space with her number, like you. You can remove her whenever you want.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">Elle ouvre son espace avec son numéro, comme toi. Tu peux la retirer quand tu veux.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_place_form
msgid "<small class=\"o_ocd_parcel_hint\">Take it there: the itinerary of the customers and the courier start from it.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">Prends-la sur place : l'itinéraire des clients et du livreur part de là.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_places
msgid "<small class=\"o_ocd_parcel_hint\">The courier picks your parcels up there; the delivery is counted from there.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">Le livreur vient y chercher tes colis ; la livraison est comptée depuis là.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_product_edit
msgid "<small class=\"o_ocd_parcel_hint\">The product is no longer shown; you can put it back when you want. It is never deleted: the past orders keep it.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">Le produit n'est plus montré ; tu peux le remettre quand tu veux. Il n'est jamais effacé : les commandes passées le gardent.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_stock_send
msgid "<small class=\"o_ocd_parcel_hint\">The stock changes at once in both stores. Each sending stays in the last changes.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">Le stock change tout de suite dans les deux magasins. Chaque envoi reste dans les derniers changements.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.report_page
msgid "<small class=\"o_ocd_parcel_hint\">The team of OCD Live looks at each report within 24 hours. The vendor does not know who reported.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">L'équipe d'OCD Live regarde chaque signalement sous 24 h. Le vendeur ne sait pas qui a signalé.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_place_form
msgid "<small class=\"o_ocd_parcel_hint\">With its sign: the customers recognise the store.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">Avec l'enseigne visible : les clients reconnaissent le magasin.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.vendor_follow
msgid "<small class=\"o_ocd_parcel_hint\">You stop whenever you want, here or by answering STOP.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">Tu arrêtes quand tu veux, ici ou en répondant STOP.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.tracking
msgid "<small class=\"o_ocd_parcel_hint\">Your first name and the initial of your name are shown, never your number.</small>"
msgstr "<small class=\"o_ocd_parcel_hint\">Ton prénom et l'initiale de ton nom sont montrés, jamais ton numéro.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.product
msgid "<small class=\"o_ocd_product_note\">The message gives your choice and the link of the product.</small>"
msgstr "<small class=\"o_ocd_product_note\">Le message contient ton choix et le lien du produit.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.programme
msgid "<small class=\"o_ocd_programme_note\">The lives of the vendors on their own accounts are added when they start.</small>"
msgstr "<small class=\"o_ocd_programme_note\">Les lives des vendeurs sur leurs propres comptes s'ajoutent quand ils commencent.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.relay_hand_over
msgid "<small class=\"o_ocd_rl_hint o_ocd_rl_muted\" data-blocked=\"The camera did not open: allow it in the browser, or choose the parcel and type the code.\">The customer shows the QR of their page, or gives their code.</small>"
msgstr "<small class=\"o_ocd_rl_hint o_ocd_rl_muted\" data-blocked=\"La caméra ne s'est pas ouverte : autorise-la dans le navigateur, ou choisis le colis et tape le code.\">Le client montre le QR de sa page, ou donne son code.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.relay_hand_over
msgid "<small class=\"o_ocd_rl_muted\">The code gives the parcel, not a name: someone else may come for the customer. 3 wrong codes lock the parcel; the team unlocks it.</small>"
msgstr "<small class=\"o_ocd_rl_muted\">C'est le code qui donne le colis, pas un nom : quelqu'un d'autre peut venir pour le client. 3 codes faux bloquent le colis ; l'équipe le débloque.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.relay_become
msgid "<small class=\"o_ocd_rl_muted\">The team comes to see your shop before opening it. You are a vendor on OCD Live with a verified store? In « My stores », tick « My store is a relay point ».</small>"
msgstr "<small class=\"o_ocd_rl_muted\">L'équipe vient voir ta boutique avant de l'ouvrir. Tu es vendeur sur OCD Live avec un magasin vérifié ? Dans « Mes magasins », coche « Mon magasin est un point relais ».</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.relay_home
msgid "<small class=\"o_ocd_rl_muted\">To change them, write to the team of OCD Live.</small>"
msgstr "<small class=\"o_ocd_rl_muted\">Pour les changer, écris à l'équipe d'OCD Live.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.relay_home
msgid "<small class=\"o_ocd_rl_muted\">« On holiday »: no new parcel, the ones kept wait for their customers.</small>"
msgstr "<small class=\"o_ocd_rl_muted\">« En congé » : plus de nouveau colis, ceux que tu gardes attendent leurs clients.</small>"

#. module: ocd_live_shop
#: model_terms:ir.ui.view,arch_db:ocd_live_shop.product
