<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.ocd.live.shop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="ocd_vendor_id" options="{'no_create': True}"/>
                <field name="ocd_sale_mode" invisible="not ocd_vendor_id"/>
                <label for="ocd_review_state" invisible="not ocd_vendor_id"/>
                <div class="d-flex gap-2 align-items-center" invisible="not ocd_vendor_id">
                    <field name="ocd_review_state" readonly="1" class="oe_inline"/>
                    <button name="action_ocd_approve" type="object" string="Approve" class="btn btn-sm btn-primary"
                            invisible="ocd_review_state != 'to_check'" groups="ocd_live.group_ocd_live_user"/>
                    <button name="action_ocd_refuse" type="object" string="Refuse" class="btn btn-sm btn-secondary"
                            invisible="ocd_review_state != 'to_check'" groups="ocd_live.group_ocd_live_user"/>
                </div>
            </field>
        </field>
    </record>

    <record id="product_template_view_list_ocd_review" model="ir.ui.view">
        <field name="name">product.template.view.list.ocd.review</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Products of the vendors">
                <field name="name"/>
                <field name="ocd_vendor_id"/>
                <field name="list_price"/>
                <field name="ocd_sale_mode" optional="show"/>
                <field name="is_published" optional="show"/>
                <field name="ocd_review_state" widget="badge" decoration-warning="ocd_review_state == 'to_check'"
                       decoration-success="ocd_review_state == 'approved'" decoration-danger="ocd_review_state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="product_template_action_ocd_vendor_products" model="ir.actions.act_window">
        <field name="name">Products of the vendors</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('ocd_vendor_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_to_sell': 1}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('product_template_view_list_ocd_review')}),
            Command.create({'view_mode': 'kanban'}),
            Command.create({'view_mode': 'form'})]"/>
    </record>

    <record id="product_template_action_ocd_to_check" model="ir.actions.act_window">
        <field name="name">Products to check</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ocd_vendor_id', '!=', False), ('ocd_review_state', '=', 'to_check')]</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('product_template_view_list_ocd_review')}),
            Command.create({'view_mode': 'form'})]"/>
    </record>

    <!-- The photo of the product in a colour (Configure, on the values of the attribute) -->
    <record id="product_template_attribute_value_view_form_ocd" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.ocd</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <field name="price_extra" position="before">
                <field name="ocd_image" widget="image" options="{'size': [160, 160]}"
                       invisible="display_type != 'color'"/>
            </field>
        </field>
    </record>
    <record id="product_template_attribute_value_view_list_ocd" model="ir.ui.view">
        <field name="name">product.template.attribute.value.list.ocd</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="ocd_image" widget="image" options="{'size': [32, 32]}" optional="show"/>
            </field>
        </field>
    </record>

    <!-- « Tell me when it is back »: what the customers wait for -->
    <record id="ocd_stock_alert_view_list" model="ir.ui.view">
        <field name="name">ocd.stock.alert.list</field>
        <field name="model">ocd.stock.alert</field>
        <field name="arch" type="xml">
            <list string="Back in stock alerts" create="0" decoration-muted="state != 'waiting'">
                <field name="create_date" string="Asked On"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="state" widget="badge" decoration-info="state == 'waiting'" decoration-success="state == 'sent'"/>
                <field name="sent_at"/>
            </list>
        </field>
    </record>
    <record id="ocd_stock_alert_view_search" model="ir.ui.view">
        <field name="name">ocd.stock.alert.search</field>
        <field name="model">ocd.stock.alert</field>
        <field name="arch" type="xml">
            <search string="Back in stock alerts">
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter name="waiting" string="Waiting" domain="[('state', '=', 'waiting')]"/>
                <separator/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>
    <record id="ocd_stock_alert_action" model="ir.actions.act_window">
        <field name="name">Back in stock alerts</field>
        <field name="res_model">ocd.stock.alert</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_waiting': 1, 'search_default_group_product': 1}</field>
        <field name="help" type="html">
            <p>The customers who asked « Tell me when it is back » on a product sold out in a colour or a size. They are told on WhatsApp as soon as the stock comes back.</p>
        </field>
    </record>

</odoo>
