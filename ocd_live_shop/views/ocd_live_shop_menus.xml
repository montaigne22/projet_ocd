<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ocd_live_regie_action" model="ir.actions.client">
        <field name="name">Live control room</field>
        <field name="tag">ocd_live_shop.regie</field>
    </record>
    <menuitem id="ocd_live_shop_regie_menu" name="Live control room" parent="ocd_live.ocd_live_menu_lives"
              action="ocd_live_regie_action" sequence="20"/>

    <menuitem id="ocd_live_shop_menu_shop" name="Shop" parent="ocd_live.ocd_live_menu_root" sequence="20"/>
    <record id="ocd_live_orders_action" model="ir.actions.client">
        <field name="name">Orders</field>
        <field name="tag">ocd_live_shop.orders</field>
    </record>
    <menuitem id="ocd_live_shop_orders_menu" name="Orders" parent="ocd_live_shop_menu_shop"
              action="ocd_live_orders_action" sequence="10"/>
    <!-- The board of the checks, with the new products, as in the design -->
    <record id="ocd_live_shop_verification_action" model="ir.actions.client">
        <field name="name">Products to check</field>
        <field name="tag">ocd_live.verification</field>
    </record>
    <menuitem id="ocd_live_shop_to_check_menu" name="Products to check" parent="ocd_live_shop_menu_shop"
              action="ocd_live_shop_verification_action" sequence="20"/>
    <menuitem id="ocd_live_shop_products_menu" name="Products of the vendors" parent="ocd_live_shop_menu_shop"
              action="product_template_action_ocd_vendor_products" sequence="30"/>

    <menuitem id="ocd_live_shop_menu_deliveries" name="Deliveries" parent="ocd_live.ocd_live_menu_root" sequence="30"/>
    <record id="ocd_live_dispatch_action" model="ir.actions.client">
        <field name="name">Dispatch</field>
        <field name="tag">ocd_live_shop.dispatch</field>
    </record>
    <menuitem id="ocd_live_shop_dispatch_menu" name="Dispatch" parent="ocd_live_shop_menu_deliveries"
              action="ocd_live_dispatch_action" sequence="10"/>
    <menuitem id="ocd_live_shop_parcels_menu" name="Deliveries" parent="ocd_live_shop_menu_deliveries"
              action="stock_picking_action_ocd_dispatch" sequence="20"/>
    <record id="ocd_live_couriers_action" model="ir.actions.client">
        <field name="name">Couriers and cash</field>
        <field name="tag">ocd_live_shop.couriers</field>
    </record>
    <menuitem id="ocd_live_shop_couriers_menu" name="Couriers and cash" parent="ocd_live_shop_menu_deliveries"
              action="ocd_live_couriers_action" sequence="30"/>
    <menuitem id="ocd_live_shop_rates_menu" name="Delivery rates" parent="ocd_live_shop_menu_deliveries"
              action="ocd_delivery_rate_action" sequence="40"/>

    <menuitem id="ocd_live_shop_payout_menu" name="Payouts" parent="ocd_live.ocd_live_menu_vendors" sequence="20"
              action="ocd_payout_action" groups="ocd_live.group_ocd_live_manager"/>

</odoo>
