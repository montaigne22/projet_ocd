<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ocd_cash_remittance_view_list" model="ir.ui.view">
        <field name="name">ocd.cash.remittance.view.list</field>
        <field name="model">ocd.cash.remittance</field>
        <field name="arch" type="xml">
            <list string="Cash of the couriers" decoration-danger="difference != 0 and state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="courier_id"/>
                <field name="amount_expected" sum="Total"/>
                <field name="amount_received" sum="Total"/>
                <field name="difference" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" decoration-warning="state == 'draft'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="ocd_cash_remittance_view_form" model="ir.ui.view">
        <field name="name">ocd.cash.remittance.view.form</field>
        <field name="model">ocd.cash.remittance</field>
        <field name="arch" type="xml">
            <form string="Cash handed over">
                <header>
                    <button name="action_done" type="object" string="Cash counted" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="courier_id" readonly="state == 'done'"/>
                            <field name="date" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_expected"/>
                            <field name="amount_received" readonly="state == 'done'"/>
                            <field name="difference" decoration-danger="difference != 0"/>
                        </group>
                    </group>
                    <field name="picking_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="partner_id" string="Customer"/>
                            <field name="ocd_cod_collected_at"/>
                            <field name="ocd_currency_id" column_invisible="True"/>
                            <field name="ocd_cod_collected_amount" sum="Total"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Notes..."/>
                    <field name="company_id" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ocd_cash_remittance_action" model="ir.actions.act_window">
        <field name="name">Cash of the couriers</field>
        <field name="res_model">ocd.cash.remittance</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
