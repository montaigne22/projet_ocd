<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- === MENU OF THE PAGES: the shop between the lives and the space === -->

    <template id="nav_links" inherit_id="ocd_live.nav_links" name="OCD Live: shop in the menu">
        <xpath expr="//a[@href='/ocd/espace/moi']" position="before">
            <a href="/shop" t-att-class="'o_ocd_on' if nav == 'shop' else None" t-att-aria-current="'page' if nav == 'shop' else None">
                <t t-call="ocd_live.icon" icon.f="bag"/><span>Shop</span>
            </a>
        </xpath>
    </template>

    <!-- === BOUTIQUE OF A VENDOR (design: Vitrine) === -->

    <template id="product_photo" name="OCD Live: photo of a product">
        <!-- Parameter: image, the url of the photo (or False) -->
        <img t-if="image" t-att-src="image" alt="" loading="lazy" class="o_ocd_photo_img"/>
        <span t-else="" class="o_ocd_photo_none">Photo</span>
    </template>

    <template id="boutique" name="OCD Live: boutique of a vendor">
        <t t-call="ocd_live.app">
            <div class="o_ocd_frame o_ocd_narrow">
                <main class="o_ocd_main o_ocd_vitrine">
                    <div class="o_ocd_vendor_head">
                        <span class="o_ocd_avatar o_ocd_avatar_big" aria-hidden="true">
                            <t t-out="initials"/>
                            <i t-attf-class="o_ocd_avatar_live #{'' if live else 'o_ocd_avatar_off'}"/>
                        </span>
                        <div class="o_ocd_vendor_text">
                            <h1 class="o_ocd_vendor_name" t-out="vendor.name"/>
                            <span t-if="categories" class="o_ocd_vendor_what" t-out="categories"/>
                            <span t-if="sold_by_ocd" class="o_ocd_mode o_ocd_mode_ocd">Sold and delivered by OCD Live</span>
                            <span t-else="" class="o_ocd_mode">Direct contact with the vendor</span>
                        </div>
                    </div>
                    <span t-if="location" class="o_ocd_vendor_place">
                        <span t-if="flag" t-attf-class="o_ocd_flag o_ocd_flag_#{flag}"/>
                        <span t-out="location"/>
                    </span>

                    <div t-if="error" class="o_ocd_alert" role="alert" t-out="error"/>

                    <div t-if="live" class="o_ocd_onair o_ocd_live_shop_live" t-att-data-vendor-id="vendor.id">
                        <div class="o_ocd_onair_bar">
                            <i class="o_ocd_onair_dot" aria-hidden="true"/>
                            <span class="o_ocd_onair_text">
                                <b>Live now</b>
                                <small t-out="live['line']"/>
                            </span>
                            <a t-if="live['booking'].live_url" t-att-href="live['booking'].live_url" target="_blank"
                               rel="noopener noreferrer" class="o_ocd_onair_watch">
                                <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="o_ocd_icon"><path d="M6 3l14 9-14 9z"/></svg>
                                <span>Watch the live</span>
                            </a>
                        </div>
                        <a t-att-href="on_screen['url'] if on_screen else '#'"
                           t-attf-class="o_ocd_onscreen #{'' if on_screen else 'd-none'}">
                            <span class="o_ocd_photo o_ocd_onscreen_photo">
                                <t t-call="ocd_live_shop.product_photo" image="on_screen and on_screen['image']"/>
                            </span>
                            <span class="o_ocd_onscreen_text">
                                <small>On screen now</small>
                                <b class="o_ocd_onscreen_name" t-out="on_screen['product'].name if on_screen else ''"/>
                                <span class="o_ocd_onscreen_price" t-out="on_screen['price'] if on_screen else ''"/>
                            </span>
                            <t t-call="ocd_live.icon" icon.f="next"/>
                        </a>
                    </div>
                    <div t-else="" class="o_ocd_next">
                        <span class="o_ocd_next_text">
                            <b t-if="next_live" t-out="next_live['title']"/>
                            <b t-else="">No live planned for now</b>
                            <small t-if="next_live" t-out="next_live['where']"/>
                        </span>
                        <div t-if="noted" class="o_ocd_next_noted" role="status" t-out="noted_text"/>
                        <form t-else="" t-attf-action="/ocd/boutique/#{vendor.id}/prevenir" method="post" class="o_ocd_wait_form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="text" name="website_url" class="o_ocd_hp" tabindex="-1" autocomplete="off" aria-hidden="true"/>
                            <button t-if="visitor" type="submit" class="o_ocd_cta o_ocd_cta_dark o_ocd_cta_small">
                                <t t-call="ocd_live.icon" icon.f="bell"/>
                                <span>Tell me on WhatsApp</span>
                            </button>
                            <details t-else="" class="o_ocd_wait_details" t-att-open="'open' if error else None">
                                <summary class="o_ocd_cta o_ocd_cta_dark o_ocd_cta_small">
                                    <t t-call="ocd_live.icon" icon.f="bell"/>
                                    <span>Tell me on WhatsApp</span>
                                </summary>
                                <div class="o_ocd_form o_ocd_wait_box">
                                    <label for="b-phone" class="o_ocd_label">Your WhatsApp</label>
                                    <t t-call="ocd_live.phone_field" field_id.f="b-phone" phone_value="''"/>
                                    <button type="submit" class="o_ocd_cta o_ocd_cta_small">Tell me</button>
                                </div>
                            </details>
                        </form>
                    </div>
                    <a t-if="replay" t-attf-href="/ocd/boutique/#{vendor.id}/replay" class="o_ocd_replay_card">
                        <span class="o_ocd_replay_thumb">
                            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="o_ocd_icon"><path d="M6 3l14 9-14 9z"/></svg>
                        </span>
                        <span class="o_ocd_replay_text">
                            <b t-out="replay['title']"/>
                            <small t-out="replay['line']"/>
                            <span class="o_ocd_link">Watch again</span>
                        </span>
                    </a>

                    <div t-if="contact['url']" class="o_ocd_contact">
                        <a t-att-href="contact['url']" class="o_ocd_cta o_ocd_cta_mid" target="_blank" rel="noopener nofollow">
                            <t t-call="ocd_live.icon" icon.f="chat"/>
                            <span t-out="contact['label']"/>
                        </a>
                        <small t-out="contact['note']"/>
                    </div>

                    <div class="o_ocd_section_head">
                        <h2>Their products</h2>
                        <span t-out="count_label"/>
                    </div>
                    <div t-if="cards" class="o_ocd_products">
                        <t t-foreach="cards" t-as="card">
                            <div t-if="card['out']" class="o_ocd_product o_ocd_product_out">
                                <span class="o_ocd_photo o_ocd_product_photo">
                                    <t t-call="ocd_live_shop.product_photo" image="card['image']"/>
                                    <span class="o_ocd_product_flag o_ocd_product_flag_out">Sold out</span>
                                </span>
                                <span class="o_ocd_product_text">
                                    <b t-out="card['product'].name"/>
                                    <span class="o_ocd_product_price" t-out="card['price']"/>
                                </span>
                            </div>
                            <a t-else="" t-att-href="card['url']" class="o_ocd_product">
                                <span class="o_ocd_photo o_ocd_product_photo">
                                    <t t-call="ocd_live_shop.product_photo" image="card['image']"/>
                                    <span t-if="card['low']" class="o_ocd_product_flag" t-out="card['low']"/>
                                </span>
                                <span class="o_ocd_product_text">
                                    <b t-out="card['product'].name"/>
                                    <span class="o_ocd_product_price" t-out="card['price']"/>
                                </span>
                            </a>
                        </t>
                    </div>
                    <div t-else="" class="o_ocd_info">The products of this boutique are coming soon.</div>
                </main>
            </div>
        </t>
    </template>

    <!-- === REPLAY OF THE LAST LIVE (design: Replay) === -->

    <template id="replay" name="OCD Live: replay of a live">
        <t t-set="first" t-value="rows[:1] and rows[0]"/>
        <t t-set="bottom_cta" t-value="{'href': first['order_url'], 'label': first['order_label']} if first else None"/>
        <t t-call="ocd_live.app">
            <div class="o_ocd_frame o_ocd_narrow">
                <main class="o_ocd_main o_ocd_replay">
                    <div class="o_ocd_video">
                        <span class="o_ocd_video_tag">Replay</span>
                        <span class="o_ocd_video_where" t-out="published_on"/>
                        <a t-att-href="replay.replay_url" target="_blank" rel="noopener noreferrer"
                           class="o_ocd_video_play o_ocd_replay_open" aria-label="Play the replay">
                            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="o_ocd_icon"><path d="M6 3l14 9-14 9z"/></svg>
                        </a>
                        <div class="o_ocd_video_bottom">
                            <div class="o_ocd_video_banner">
                                <span class="o_ocd_video_logo">OCD</span>
                                <span class="o_ocd_video_banner_text">
                                    <b t-out="banner"/>
                                    <small t-out="shop_line"/>
                                </span>
                            </div>
                            <div class="o_ocd_video_time">
                                <span class="o_ocd_video_now" t-out="first['moment'].offset_label if first else '0:00'"/>
                                <span class="o_ocd_video_track"><i/></span>
                                <span t-out="duration"/>
                            </div>
                        </div>
                    </div>
                    <div class="o_ocd_replay_head">
                        <h1 t-out="title"/>
                        <span t-out="line"/>
                    </div>
                    <t t-if="rows">
                        <div class="o_ocd_section_head">
                            <h2>Products shown</h2>
                            <span>Tap to go to the moment</span>
                        </div>
                        <div class="o_ocd_moments">
                            <t t-foreach="rows" t-as="row">
                                <div t-attf-class="o_ocd_moment #{'o_ocd_on' if row_first else ''}">
                                    <a t-att-href="row['url']" target="_blank" rel="noopener noreferrer" class="o_ocd_moment_go"
                                       t-att-data-order-url="row['order_url']" t-att-data-order-label="row['order_label']"
                                       t-att-data-time="row['moment'].offset_label"
                                       t-att-aria-label="row['aria']">
                                        <span class="o_ocd_moment_time" t-out="row['moment'].offset_label"/>
                                        <span class="o_ocd_photo o_ocd_moment_photo">
                                            <t t-call="ocd_live_shop.product_photo" image="row['image']"/>
                                        </span>
                                        <span class="o_ocd_moment_text">
                                            <b t-out="row['product'].name"/>
                                            <span t-out="row['price']"/>
                                        </span>
                                    </a>
                                    <a t-att-href="row['see_url']" class="o_ocd_link o_ocd_moment_see"
                                       t-att-aria-label="row['see_aria']">See</a>
                                </div>
                            </t>
                        </div>
                    </t>
                </main>
            </div>
        </t>
    </template>

    <!-- === DELIVERY APP OF THE VENDORS (design: Livrer) AND OF THE COURIERS (design: Tournee) === -->

    <template id="parcel_feedback" name="OCD Live: answer about a parcel">
        <t t-if="card_id == card['parcel'].id">
            <span t-if="card_message" class="o_ocd_parcel_note o_ocd_parcel_note_ok" role="status" t-out="card_message"/>
            <span t-if="card_error" class="o_ocd_parcel_error" role="alert" t-out="card_error"/>
        </t>
    </template>

    <template id="parcel_on_the_way" name="OCD Live: parcel on the way, at the door">
        <!-- Parameter: card. Call, payment at the door, code of the customer, problem. -->
        <t t-set="parcel" t-value="card['parcel']"/>
        <div class="o_ocd_parcel_contact">
            <a t-if="card['phone']" t-attf-href="tel:+#{card['phone']}" class="o_ocd_parcel_button">Call</a>
            <a t-if="card['whatsapp']" t-att-href="card['whatsapp']" target="_blank" rel="noopener" class="o_ocd_parcel_button">WhatsApp</a>
        </div>
        <t t-if="parcel.ocd_cod_state == 'to_collect' and card['methods']">
            <span class="o_ocd_parcel_label" t-out="card['pay_question']"/>
            <div class="o_ocd_parcel_pair">
                <details t-if="'online' in card['methods'] or 'momo_declared' in card['methods']" class="o_ocd_parcel_momo">
                    <summary class="o_ocd_parcel_button">Mobile Money</summary>
                    <div class="o_ocd_parcel_momo_box">
                        <t t-if="'online' in card['methods']">
                            <t t-set="qr" t-value="payment_qr(parcel)"/>
                            <img t-att-src="qr['src']" alt="QR code of the payment" width="220" height="220"/>
                            <span>The customer scans this code and pays on their phone. The parcel is marked paid by itself.</span>
                            <a t-attf-href="#{base}#colis-#{parcel.id}" class="o_ocd_link">See if it is paid</a>
                        </t>
                        <form t-if="'momo_declared' in card['methods']" t-attf-action="#{base}/colis/#{parcel.id}/collect" method="post" class="o_ocd_code_row">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="method" value="momo_declared"/>
                            <label class="visually-hidden" t-attf-for="ref_#{parcel.id}">Reference of the payment</label>
                            <input t-attf-id="ref_#{parcel.id}" name="reference" class="o_ocd_input" placeholder="Reference of the payment" required="required"/>
                            <button class="o_ocd_parcel_go">Received</button>
                        </form>
                    </div>
                </details>
                <form t-if="'cash' in card['methods']" t-attf-action="#{base}/colis/#{parcel.id}/collect" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="method" value="cash"/>
                    <button class="o_ocd_parcel_button">Cash received</button>
                </form>
            </div>
        </t>
        <span t-elif="parcel.ocd_cod_state == 'to_collect'" class="o_ocd_parcel_alert" role="alert">This parcel is paid before the handover: call the OCD team before you give it.</span>
        <form t-if="parcel.ocd_cod_state != 'to_collect'" t-attf-action="#{base}/colis/#{parcel.id}/code" method="post" class="o_ocd_parcel_code">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <label t-attf-for="code_#{parcel.id}" class="o_ocd_parcel_label" t-out="card['code_label']"/>
            <div class="o_ocd_code_row">
                <input t-attf-id="code_#{parcel.id}" name="code" inputmode="numeric" maxlength="4" autocomplete="off"
                       t-attf-class="o_ocd_code_input #{'o_ocd_code_wrong' if card_error and card_id == parcel.id else ''}" required="required"/>
                <button class="o_ocd_parcel_go">Check</button>
            </div>
        </form>
        <t t-call="ocd_live_shop.parcel_feedback"/>
        <details class="o_ocd_parcel_problem">
            <summary>A problem?</summary>
            <form t-attf-action="#{base}/colis/#{parcel.id}/problem" method="post" class="o_ocd_parcel_reasons">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <t t-foreach="reasons" t-as="reason">
                    <button name="reason" t-att-value="reason[0]" class="o_ocd_parcel_button" t-out="reason[1]"/>
                </t>
            </form>
        </details>
    </template>

    <template id="parcel_card_body" name="OCD Live: lines of a parcel">
        <span t-if="card['place']" class="o_ocd_parcel_place" t-out="card['place']"/>
        <span class="o_ocd_parcel_items" t-out="card['items']"/>
        <span t-attf-class="o_ocd_parcel_pay o_ocd_parcel_pay_#{card['pay']}" t-out="card['pay_label']"/>
    </template>

    <template id="delivery_app" name="OCD Live: my parcels">
        <t t-set="reasons" t-value="request.env['stock.picking']._fields['ocd_problem_reason']._description_selection(request.env)"/>
        <t t-call="ocd_live.app">
            <div class="o_ocd_frame o_ocd_narrow">
                <main class="o_ocd_main o_ocd_parcels">
                    <h1 class="o_ocd_parcels_hello" t-out="hello"/>
                    <span t-if="payout_line" class="o_ocd_parcels_payout" t-out="payout_line"/>
                    <t t-call="ocd_live.message_box"/>
                    <nav class="o_ocd_tabs" aria-label="My parcels">
                        <a t-att-href="base" t-att-class="'o_ocd_on' if tab == 'todo' else None"
                           t-att-aria-current="'page' if tab == 'todo' else None" t-out="todo_label"/>
                        <a t-attf-href="#{base}?vue=livres" t-att-class="'o_ocd_on' if tab == 'done' else None"
                           t-att-aria-current="'page' if tab == 'done' else None" t-out="done_label"/>
                    </nav>
                    <t t-if="tab == 'todo'">
                        <t t-foreach="cards" t-as="card">
                            <t t-set="parcel" t-value="card['parcel']"/>
                            <div t-attf-class="o_ocd_parcel #{'o_ocd_parcel_on' if parcel.ocd_stage == 'on_the_way' and card['delivers'] else ''} o_ocd_live_shop_parcel"
                                 t-attf-id="colis-#{parcel.id}">
                                <div class="o_ocd_parcel_head">
                                    <b t-out="card['for_title']"/>
                                    <span t-attf-class="o_ocd_step_pill o_ocd_step_pill_#{card['pill']}" t-out="card['pill_label']"/>
                                </div>
                                <t t-call="ocd_live_shop.parcel_card_body"/>
                                <div t-if="card['other_courier'] and card['prepares']" class="o_ocd_parcel_courier">
                                    <span class="o_ocd_parcel_initials" aria-hidden="true" t-out="card['other_initials']"/>
                                    <span t-out="card['other_line']"/>
                                </div>
                                <span t-else="" class="o_ocd_parcel_when" t-out="card['when']"/>

                                <t t-if="parcel.ocd_code_locked">
                                    <span class="o_ocd_parcel_alert" role="alert">3 wrong codes. Do not leave the parcel: the OCD team calls you right away.</span>
                                </t>
                                <t t-elif="parcel.ocd_stage == 'problem'">
                                    <span class="o_ocd_parcel_note o_ocd_parcel_note_warn" role="status" t-out="card['problem_line']"/>
                                    <form t-if="card['delivers']" t-attf-action="#{base}/colis/#{parcel.id}/retry" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button class="o_ocd_parcel_button o_ocd_parcel_wide">Resume the delivery</button>
                                    </form>
                                </t>
                                <t t-elif="card['prepares'] and parcel.ocd_stage == 'to_prepare'">
                                    <form t-attf-action="#{base}/colis/#{parcel.id}/ready" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button class="o_ocd_parcel_go o_ocd_parcel_wide">It is ready</button>
                                    </form>
                                </t>
                                <t t-elif="card['delivers'] and parcel.ocd_stage in ('ready', 'picked') and not card['to_pick']">
                                    <span t-if="parcel.ocd_cod_state == 'to_collect' and card['methods']" class="o_ocd_parcel_note">
                                        Ready. At the door, tap “Mobile Money” for the customer to pay on their phone, or take the cash.
                                    </span>
                                    <form t-attf-action="#{base}/colis/#{parcel.id}/leave" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button class="o_ocd_parcel_go o_ocd_parcel_wide">I leave to deliver</button>
                                    </form>
                                    <span class="o_ocd_parcel_hint" t-out="card['leave_note']"/>
                                </t>
                                <t t-elif="card['delivers'] and card['to_pick']">
                                    <form t-attf-action="#{base}/colis/#{parcel.id}/pickup" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button class="o_ocd_parcel_go o_ocd_parcel_wide">I picked the parcel up</button>
                                    </form>
                                </t>
                                <t t-elif="card['delivers'] and parcel.ocd_stage == 'on_the_way'">
                                    <span t-if="card['agency_line']" class="o_ocd_parcel_note" role="status" t-out="card['agency_line']"/>
                                    <t t-else="" t-call="ocd_live_shop.parcel_on_the_way"/>
                                </t>
                                <t t-elif="card['prepares'] and parcel.ocd_stage == 'ready' and card['other_courier']">
                                    <span class="o_ocd_parcel_note" role="status" t-out="card['ready_line']"/>
                                </t>
                                <t t-elif="card['prepares'] and parcel.ocd_stage in ('picked', 'on_the_way') and card['picked_line']">
                                    <span class="o_ocd_parcel_note o_ocd_parcel_note_ok" role="status" t-out="card['picked_line']"/>
                                </t>
                                <t t-if="parcel.ocd_stage != 'on_the_way' or not card['delivers']" t-call="ocd_live_shop.parcel_feedback"/>
                            </div>
                        </t>
                        <div t-if="not cards" class="o_ocd_info">No parcel to prepare or to deliver.</div>
                    </t>
                    <t t-else="">
                        <div class="o_ocd_done_list">
                            <t t-foreach="done_rows" t-as="row">
                                <div class="o_ocd_done_row">
                                    <span class="o_ocd_done_text">
                                        <b t-out="row['who']"/>
                                        <span t-out="row['detail']"/>
                                    </span>
                                    <span t-if="row['forced']" class="o_ocd_step_pill o_ocd_step_pill_ready">Validated by the team</span>
                                    <span t-else="" class="o_ocd_step_pill o_ocd_step_pill_done">Code checked</span>
                                </div>
                            </t>
                        </div>
                        <div t-if="not done_rows" class="o_ocd_info">No parcel delivered yet.</div>
                    </t>
                </main>
            </div>
        </t>
    </template>

    <template id="delivery_tour" name="OCD Live: tour of the courier">
        <t t-set="reasons" t-value="request.env['stock.picking']._fields['ocd_problem_reason']._description_selection(request.env)"/>
        <t t-set="bottom_cta" t-value="{'href': 'tel:+%s' % dispatch_phone, 'label': call_label} if dispatch_phone else None"/>
        <t t-call="ocd_live.app">
            <div class="o_ocd_frame o_ocd_narrow">
                <main class="o_ocd_main o_ocd_parcels o_ocd_tour">
                    <div class="o_ocd_tour_head">
                        <div>
                            <h1>My tour</h1>
                            <span t-out="tour_line"/>
                        </div>
                        <form t-attf-action="#{base}/service" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button t-attf-class="o_ocd_duty #{'o_ocd_on' if partner.ocd_courier_available else ''}"
                                    t-att-aria-pressed="'true' if partner.ocd_courier_available else 'false'">
                                <i aria-hidden="true"/>
                                <span t-if="partner.ocd_courier_available">On duty</span>
                                <span t-else="">Off duty</span>
                            </button>
                        </form>
                    </div>
                    <div class="o_ocd_tour_sum">
                        <span t-out="left_label"/>
                        <span>Cash on me: <b t-out="cash"/></span>
                    </div>
                    <t t-call="ocd_live.message_box"/>
                    <t t-foreach="last_done" t-as="row">
                        <div class="o_ocd_tour_done">
                            <t t-call="ocd_live.icon" icon.f="check"/>
                            <span><b t-out="row['title']"/> · <t t-out="row['line']"/></span>
                        </div>
                    </t>
                    <t t-foreach="steps" t-as="step">
                        <t t-set="card" t-value="step['card']"/>
                        <t t-set="parcel" t-value="card['parcel']"/>
                        <div t-attf-class="o_ocd_parcel #{'o_ocd_parcel_on' if step_first else ''}">
                            <div class="o_ocd_parcel_head">
                                <span class="o_ocd_step_number" t-out="step['number']"/>
                                <b t-if="step['kind'] == 'pickup'" t-out="card['pickup_title']"/>
                                <b t-else="" t-out="card['deliver_title']"/>
                            </div>
                            <t t-if="step['kind'] == 'pickup'">
                                <span t-if="card['pickup_place']" class="o_ocd_parcel_place" t-out="card['pickup_place']"/>
                                <span class="o_ocd_parcel_items" t-out="card['items']"/>
                                <span class="o_ocd_parcel_when" t-out="card['when']"/>
                                <form t-attf-action="#{base}/colis/#{parcel.id}/pickup" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button class="o_ocd_parcel_go o_ocd_parcel_wide">I picked the parcel up</button>
                                </form>
                                <span t-if="card['pickup_note']" class="o_ocd_parcel_hint" t-out="card['pickup_note']"/>
                                <t t-call="ocd_live_shop.parcel_feedback"/>
                            </t>
                            <t t-else="">
                                <t t-call="ocd_live_shop.parcel_card_body"/>
                                <span class="o_ocd_parcel_when" t-out="card['when']"/>
                                <span t-if="card['to_pick']" class="o_ocd_parcel_hint" t-out="card['first_pick']"/>
                                <t t-elif="parcel.ocd_code_locked">
                                    <span class="o_ocd_parcel_alert" role="alert">3 wrong codes. Do not leave the parcel: the OCD team calls you right away.</span>
                                </t>
                                <t t-elif="parcel.ocd_stage == 'problem'">
                                    <span class="o_ocd_parcel_note o_ocd_parcel_note_warn" role="status" t-out="card['problem_line']"/>
                                    <form t-attf-action="#{base}/colis/#{parcel.id}/retry" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button class="o_ocd_parcel_button o_ocd_parcel_wide">Resume the delivery</button>
                                    </form>
                                </t>
                                <t t-elif="parcel.ocd_stage in ('ready', 'picked')">
                                    <form t-attf-action="#{base}/colis/#{parcel.id}/leave" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button class="o_ocd_parcel_go o_ocd_parcel_wide">I leave to deliver</button>
                                    </form>
                                    <span class="o_ocd_parcel_hint" t-out="card['leave_note']"/>
                                </t>
                                <t t-elif="parcel.ocd_stage == 'on_the_way'">
                                    <span t-if="card['agency_line']" class="o_ocd_parcel_note" role="status" t-out="card['agency_line']"/>
                                    <t t-else="" t-call="ocd_live_shop.parcel_on_the_way"/>
                                </t>
                                <t t-if="parcel.ocd_stage != 'on_the_way'" t-call="ocd_live_shop.parcel_feedback"/>
                            </t>
                        </div>
                    </t>
                    <div t-if="not steps" class="o_ocd_info">No parcel in your tour for now.</div>
                    <div class="o_ocd_tour_end" t-out="end_line"/>
                </main>
            </div>
        </t>
    </template>

    <!-- === PARCELS ON THE ORDER PAGE OF THE CUSTOMER === -->

    <template id="sale_order_portal_content" inherit_id="sale.sale_order_portal_content" name="OCD Live: parcels of the order">
        <xpath expr="//div[@id='introduction']" position="after">
            <t t-set="ocd_parcels" t-value="sale_order.sudo().ocd_parcel_ids"/>
            <div t-if="ocd_parcels" class="p-3 border border-top-0 o_ocd_live_shop_portal_parcels">
                <h4>Your parcels</h4>
                <t t-foreach="ocd_parcels" t-as="parcel">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 border-bottom">
                        <span>
                            <b t-out="parcel.ocd_vendor_id.ocd_business or parcel.ocd_vendor_id.name or parcel.company_id.name"/>
                            <span class="text-muted"> · <t t-out="parcel.ocd_courier_id.name or ''"/></span>
                        </span>
                        <span class="badge text-bg-light" t-field="parcel.ocd_stage"/>
                        <span t-if="parcel.ocd_stage == 'on_the_way'" class="fs-4 fw-bold">
                            Code: <t t-out="parcel.sudo().ocd_delivery_code"/>
                        </span>
                    </div>
                </t>
                <p t-if="any(p.ocd_stage == 'on_the_way' for p in ocd_parcels)" class="small text-muted mb-0 mt-2">
                    Give the code only when you have the parcel in your hands.
                </p>
            </div>
        </xpath>
    </template>

    <template id="parcel_pay" name="OCD Live: pay a parcel at the door">
        <t t-call="ocd_live.app">
            <div class="o_ocd_frame o_ocd_narrow">
                <main class="o_ocd_main o_ocd_pay" t-att-data-state="state">
                    <h1 class="o_ocd_h1">Pay the parcel</h1>
                    <div class="o_ocd_recap">
                        <b t-out="parcel.ocd_vendor_id.name or parcel.company_id.name"/>
                        <span>Parcel <t t-out="parcel.name"/></span>
                    </div>
                    <div t-if="state == 'failed'" class="o_ocd_failed" role="alert">
                        <b>The payment did not go through.</b>
                        <span>Refused or cancelled on the phone, or not enough money. Nothing was taken.</span>
                    </div>
                    <t t-if="state in ('form', 'failed')">
                        <div class="o_ocd_with_what">
                            <span>With what?</span>
                            <t t-if="country">
                                <span t-attf-class="o_ocd_flag o_ocd_flag_#{(country.code or '').lower()}"/>
                                <span class="o_ocd_with_country" t-out="country.name"/>
                            </t>
                        </div>
                        <div class="o_ocd_payment">
                            <t t-call="payment.form"/>
                        </div>
                        <div class="o_ocd_total">
                            <span>Total</span>
                            <b t-out="total"/>
                        </div>
                    </t>
                    <t t-elif="state == 'waiting'">
                        <div class="o_ocd_wait" role="status">
                            <div class="o_ocd_wait_head">
                                <span class="o_ocd_spinner" aria-hidden="true"/>
                                <b>Payment in progress</b>
                            </div>
                            <div class="o_ocd_wait_text">
                                <t t-call="payment.state_header"/>
                            </div>
                            <small>Type your secret code on your phone only, never here.</small>
                        </div>
                        <a t-attf-href="/ocd/colis/#{parcel.id}/payer?access_token=#{access_token}" class="o_ocd_cta o_ocd_cta_line">See if it is paid</a>
                    </t>
                    <div t-else="" class="o_ocd_ok o_ocd_ok_big" role="status">
                        <b>Paid. Thank you!</b>
                        <span>Give the code you received to the courier to get your parcel.</span>
                    </div>
                </main>
            </div>
        </t>
    </template>

    <template id="footer_shop_link" inherit_id="ocd_live.footer" name="OCD Live: shop in the footer of the site">
        <xpath expr="//ul[@id='o_ocd_footer_links']/li[2]" position="after">
            <li><a href="/shop">Shop</a></li>
        </xpath>
        <xpath expr="//ul[@id='o_ocd_footer_links']" position="inside">
            <li><a href="/ocd/livrer">Couriers' space</a></li>
        </xpath>
    </template>

</odoo>
