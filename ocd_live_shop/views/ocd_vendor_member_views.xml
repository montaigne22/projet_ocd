<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The team of a vendor (chantier 22, A.9 of the plan, design EquipeDuVendeur): the people
         who hold the stores, on the form of the vendor -->
    <record id="ocd_vendor_member_view_list" model="ir.ui.view">
        <field name="name">ocd.vendor.member.list</field>
        <field name="model">ocd.vendor.member</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active or state == 'paused'">
                <field name="name"/>
                <field name="partner_id" options="{'no_quick_create': True}"
                       domain="[('ocd_is_vendor', '=', False), ('ocd_is_courier', '=', False)]"/>
                <field name="phone" readonly="1"/>
                <field name="vendor_id" column_invisible="context.get('default_vendor_id')" options="{'no_create': True}"/>
                <field name="place_id" options="{'no_create': True}"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"
                       decoration-warning="state == 'waiting'" decoration-muted="state == 'paused'"/>
                <field name="last_visit"/>
                <field name="invited_at" optional="hide"/>
                <field name="active" widget="boolean_toggle" string="In The Team"/>
                <field name="company_id" column_invisible="True"/>
                <button name="action_ocd_send_link" type="object" string="Send her link" icon="fa-whatsapp"
                        invisible="not id or not active"/>
            </list>
        </field>
    </record>

    <record id="ocd_vendor_member_view_search" model="ir.ui.view">
        <field name="name">ocd.vendor.member.search</field>
        <field name="model">ocd.vendor.member</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="place_id"/>
                <field name="phone"/>
                <filter name="removed" string="Removed" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
            </search>
        </field>
    </record>

    <record id="ocd_vendor_member_action" model="ir.actions.act_window">
        <field name="name">Teams of the vendors</field>
        <field name="res_model">ocd.vendor.member</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_vendor': 1}</field>
        <field name="help" type="html">
            <p>The people who hold the stores of the vendors (OCD Business): the stock and the parcels of their store, without the prices or the payouts. The vendor adds them from « My team ».</p>
        </field>
    </record>

    <record id="res_partner_view_form_ocd_vendor_team" model="ir.ui.view">
        <field name="name">res.partner.view.form.ocd.vendor.team</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="ocd_live_shop.res_partner_view_form_ocd_vendor_places"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='ocd_places']" position="after">
                <page name="ocd_team" string="Team">
                    <field name="ocd_team_ids" context="{'default_vendor_id': id, 'active_test': False}"/>
                    <group>
                        <group>
                            <field name="ocd_team_max"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                Without OCD Business, the team is paused: nothing is deleted, it comes back with the formula.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
