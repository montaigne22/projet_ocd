<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The followers of the vendors (chantier 1, design SuivreVendeur): who, since when, what
         they receive. The vendor only sees how many. -->
    <record id="ocd_vendor_follower_view_list" model="ir.ui.view">
        <field name="name">ocd.vendor.follower.list</field>
        <field name="model">ocd.vendor.follower</field>
        <field name="arch" type="xml">
            <list create="false" decoration-muted="not active">
                <field name="followed_at"/>
                <field name="partner_id"/>
                <field name="vendor_id" column_invisible="context.get('default_vendor_id')"/>
                <field name="lives" widget="boolean_toggle"/>
                <field name="news" widget="boolean_toggle"/>
                <field name="source" optional="show"/>
                <field name="live_told_at" optional="show"/>
                <field name="news_told_at" optional="hide"/>
                <field name="active" widget="boolean_toggle" string="Follows"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ocd_vendor_follower_view_search" model="ir.ui.view">
        <field name="name">ocd.vendor.follower.search</field>
        <field name="model">ocd.vendor.follower</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="vendor_id"/>
                <filter name="news" string="Want the news" domain="[('news', '=', True)]"/>
                <filter name="stopped" string="No longer follow" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                <filter name="group_source" string="Followed From" context="{'group_by': 'source'}"/>
            </search>
        </field>
    </record>

    <record id="ocd_vendor_follower_action" model="ir.actions.act_window">
        <field name="name">Followers of the vendors</field>
        <field name="res_model">ocd.vendor.follower</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_vendor': 1}</field>
        <field name="help" type="html">
            <p>The customers who follow a vendor: a WhatsApp at each live of the vendor, and their news on Friday if they want. The vendor sees how many, never their numbers.</p>
        </field>
    </record>

    <record id="res_partner_view_form_ocd_vendor_followers" model="ir.ui.view">
        <field name="name">res.partner.view.form.ocd.vendor.followers</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="ocd_live.res_partner_view_form_ocd_vendor"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ocd_view_followers" type="object" class="oe_stat_button" icon="notifications">
                    <field name="ocd_follower_count" widget="statinfo" string="Followers"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
