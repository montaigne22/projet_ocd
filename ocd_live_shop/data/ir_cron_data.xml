<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_parcel_escalation" model="ir.cron">
        <field name="name">OCD Live: remind the vendors and alert the dispatch</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_ocd_escalate()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_prepare_payouts" model="ir.cron">
        <field name="name">OCD Live: prepare the payouts of the vendors</field>
        <field name="model_id" ref="model_ocd_payout"/>
        <field name="state">code</field>
        <field name="code">model._cron_prepare()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="ir_cron_stock_alerts" model="ir.cron">
        <field name="name">OCD Live: tell the customers that a product is back</field>
        <field name="model_id" ref="model_ocd_stock_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_back()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_vendor_news" model="ir.cron">
        <field name="name">OCD Live: the news of the vendors to their followers</field>
        <field name="model_id" ref="model_ocd_vendor_follower"/>
        <field name="state">code</field>
        <field name="code">model._ocd_send_news()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

    <record id="ir_cron_week_summary" model="ir.cron">
        <field name="name">OCD Live: the summary of the week to the vendors</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._ocd_send_week_summaries()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

    <record id="ir_cron_boutique_alerts" model="ir.cron">
        <field name="name">OCD Live: tell the visitors that a vendor is live</field>
        <field name="model_id" ref="model_ocd_boutique_alert"/>
        <field name="state">code</field>
        <field name="code">model._ocd_send_due()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>

    <!-- The parcels waiting in a store: a reminder the day before the end, then cancelled -->
    <record id="ir_cron_collect" model="ir.cron">
        <field name="name">OCD Live: parcels to pick up in a store</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_ocd_collect()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

    <!-- The pieces held to try past their time: on sale again -->
    <record id="ir_cron_holds" model="ir.cron">
        <field name="name">OCD Live: pieces held to try, past their time</field>
        <field name="model_id" ref="model_ocd_product_hold"/>
        <field name="state">code</field>
        <field name="code">model._cron_ocd_holds()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>

    <!-- The vendors back from holiday: the orders start again, the customers who asked are told -->
    <record id="ir_cron_holiday_back" model="ir.cron">
        <field name="name">OCD Live: vendors back from holiday</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_holiday_back()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

</odoo>
