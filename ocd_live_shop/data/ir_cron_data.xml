<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_parcel_escalation" model="ir.cron">
        <field name="name">OCD Live: remind the vendors and alert the dispatch</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_ocd_escalate()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_prepare_payouts" model="ir.cron">
        <field name="name">OCD Live: prepare the payouts of the vendors</field>
        <field name="model_id" ref="model_ocd_payout"/>
        <field name="state">code</field>
        <field name="code">model._cron_prepare()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="ir_cron_boutique_alerts" model="ir.cron">
        <field name="name">OCD Live: tell the visitors that a vendor is live</field>
        <field name="model_id" ref="model_ocd_boutique_alert"/>
        <field name="state">code</field>
        <field name="code">model._ocd_send_due()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>

</odoo>
