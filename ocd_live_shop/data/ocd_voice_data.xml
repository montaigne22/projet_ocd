<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="voice_prompt_boutique" model="ocd.voice.prompt">
        <field name="key">boutique</field>
        <field name="name">Boutique of a vendor</field>
        <field name="text">Here are the products of the vendor. Buy, or write to the vendor on WhatsApp.</field>
        <field name="sequence">20</field>
    </record>

    <!-- The help of the validated design (MesProduits), for the vendors who read little -->
    <record id="voice_prompt_mes_produits" model="ocd.voice.prompt">
        <field name="key">mes_produits</field>
        <field name="name">My products</field>
        <field name="text">Take a photo, write the name and the price, then tap the orange button. Below, the minus and the plus change how many you have.</field>
        <field name="sequence">22</field>
    </record>

    <record id="voice_prompt_livrer" model="ocd.voice.prompt">
        <field name="key">livrer</field>
        <field name="name">My parcels</field>
        <field name="text">Here are your parcels. Prepare them, then type the code of the customer when you deliver.</field>
        <field name="sequence">21</field>
    </record>

</odoo>
