<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="voice_prompt_boutique" model="ocd.voice.prompt">
        <field name="key">boutique</field>
        <field name="name">Boutique of a vendor</field>
        <field name="text">Here are the products of the vendor. Buy, or write to the vendor on WhatsApp.</field>
        <field name="sequence">20</field>
    </record>

    <record id="voice_prompt_livrer" model="ocd.voice.prompt">
        <field name="key">livrer</field>
        <field name="name">My parcels</field>
        <field name="text">Here are your parcels. Prepare them, then type the code of the customer when you deliver.</field>
        <field name="sequence">21</field>
    </record>

</odoo>
