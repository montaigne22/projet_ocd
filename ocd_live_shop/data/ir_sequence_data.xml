<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="seq_ocd_payout" model="ir.sequence">
            <field name="name">Vendor Payout</field>
            <field name="code">ocd.payout</field>
            <field name="prefix">PAYOUT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_ocd_cash_remittance" model="ir.sequence">
            <field name="name">Cash Of The Couriers</field>
            <field name="code">ocd.cash.remittance</field>
            <field name="prefix">CASH/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

</odoo>
