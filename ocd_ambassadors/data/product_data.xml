<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- The lines of the bills and the credit notes of the ambassadors -->
    <record id="product_ambassador_gain" model="product.template">
        <field name="name">Gain of an ambassador</field>
        <field name="type">service</field>
        <field name="categ_id" ref="ocd_live.product_category_lives"/>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="True"/>
        <field name="list_price">0</field>
    </record>

    <record id="product_ambassador_taken_back" model="product.template">
        <field name="name">Gain of an ambassador taken back</field>
        <field name="type">service</field>
        <field name="categ_id" ref="ocd_live.product_category_lives"/>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="True"/>
        <field name="list_price">0</field>
    </record>

</odoo>
