    </record>

    <!-- === Customers and courier in Douala === -->
    <record id="customer_estelle" model="res.partner">
        <field name="name">Estelle Ngono</field>
        <field name="phone">+237 670000101</field>
        <field name="country_id" ref="base.cm"/>
        <field name="city_id" ref="delivery_cameroon.city_cm_douala"/>
        <field name="district_id" ref="delivery_cameroon.district_douala_akwa"/>
        <field name="delivery_landmark">Derrière la boulangerie Saker</field>
    </record>
    <record id="customer_herve" model="res.partner">
        <field name="name">Hervé Kuete</field>
        <field name="phone">+237 694000102</field>
        <field name="country_id" ref="base.cm"/>
        <field name="city_id" ref="delivery_cameroon.city_cm_douala"/>
