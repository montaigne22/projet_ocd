        <field name="phone">+237 690112203</field>
        <field name="country_id" ref="base.cm"/>
        <field name="city_id" ref="delivery_cameroon.city_cm_douala"/>
        <field name="district_id" ref="delivery_cameroon.district_douala_makepe"/>
        <field name="ocd_sale_mode">ocd</field>
        <field name="ocd_delivery_mode">vendor</field>
        <field name="ocd_zone_ids" eval="[Command.set([ref('delivery_cameroon.district_douala_akwa'), ref('delivery_cameroon.district_douala_makepe')])]"/>
        <field name="ocd_zone_fallback" eval="True"/>
        <field name="ocd_commission_rate">15</field>
    </record>
    <record id="vendor_papa" model="res.partner">
        <field name="name">Papa Ndolé</field>
        <field name="is_company" eval="True"/>
