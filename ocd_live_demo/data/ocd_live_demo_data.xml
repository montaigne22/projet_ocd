    <!-- === Products of the vendors === -->
    <record id="product_wax_dress" model="product.template">
        <field name="name">Robe en wax</field>
        <field name="type">consu</field>
        <field name="list_price">12000</field>
        <field name="taxes_id" eval="[Command.clear()]"/>
        <field name="ocd_vendor_id" ref="vendor_brenda"/>
        <field name="is_published" eval="True"/>
        <field name="description_sale">Robe longue en wax, coupe droite, tailles S à XL.</field>
        <field name="image_1920" type="bytes" file="ocd_live_demo/static/img/robe_wax.jpg"/>
        <field name="is_storable" eval="True"/>
        <field name="allow_out_of_stock_order" eval="False"/>
        <field name="attribute_line_ids" eval="[
            Command.create({'attribute_id': ref('attribute_color'), 'value_ids': [Command.set([ref('attribute_color_blue'), ref('attribute_color_red')])]}),
            Command.create({'attribute_id': ref('attribute_size'), 'value_ids': [Command.set([ref('attribute_size_s'), ref('attribute_size_m'), ref('attribute_size_l'), ref('attribute_size_xl')])]}),
        ]"/>
    </record>
