<?xml version="1.0" encoding="utf-8"?>
<!-- Demo records of OCD Live. They all belong to this module: uninstalling it removes them.
     The lives, the directory links and the orders, which depend on the day, are created by
     the hook of the installation. -->
<odoo noupdate="1">

    <!-- === Vendors === -->
    <record id="vendor_awa" model="res.partner">
        <field name="name">Awa Mensah</field>
        <field name="is_company" eval="True"/>
        <field name="ocd_is_vendor" eval="True"/>
        <field name="ocd_vendor_state">approved</field>
        <field name="ocd_category_id" ref="ocd_live.category_food"/>
        <field name="ocd_business">Gâteaux et jus naturels</field>
        <field name="phone">+228 90112201</field>
        <field name="city">Lomé</field>
        <field name="country_id" ref="base.tg"/>
        <field name="ocd_whatsapp_optin" eval="True"/>
        <field name="ocd_sale_mode">direct</field>
    </record>
    <!-- A vendor who just registered: to check by the team -->
    <record id="vendor_yao" model="res.partner">
        <field name="name">Yao Vaisselle</field>
        <field name="is_company" eval="True"/>
        <field name="ocd_is_vendor" eval="True"/>
        <field name="ocd_vendor_state">to_check</field>
        <field name="ocd_category_id" ref="ocd_live.category_home"/>
        <field name="ocd_business">Vaisselle et ustensiles de cuisine</field>
        <field name="phone">+228 90112299</field>
        <field name="city">Lomé</field>
        <field name="country_id" ref="base.tg"/>
    </record>
    <record id="vendor_brenda" model="res.partner">
        <field name="name">Brenda Wax</field>
        <field name="is_company" eval="True"/>
