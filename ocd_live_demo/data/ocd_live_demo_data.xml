        <field name="country_id" ref="base.cm"/>
        <field name="city_id" ref="delivery_cameroon.city_cm_douala"/>
        <field name="ocd_sale_mode">direct</field>
    </record>
    <record id="vendor_junior" model="res.partner">
        <field name="name">Junior Gadgets</field>
        <field name="is_company" eval="True"/>
        <field name="ocd_is_vendor" eval="True"/>
        <field name="ocd_vendor_state">approved</field>
        <field name="ocd_category_id" ref="ocd_live.category_phones"/>
