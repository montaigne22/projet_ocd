    <!-- A product added by a vendor from the space: to check by the team -->
    <record id="product_pineapple_cake" model="product.template">
        <field name="name">Gâteau à l'ananas</field>
        <field name="type">consu</field>
        <field name="list_price">3000</field>
        <field name="taxes_id" eval="[Command.clear()]"/>
        <field name="ocd_vendor_id" ref="vendor_awa"/>
        <field name="ocd_review_state">to_check</field>
    </record>

</odoo>
