    <record id="attribute_color_blue" model="product.attribute.value">
        <field name="name">Bleu</field>
        <field name="attribute_id" ref="attribute_color"/>
        <field name="html_color">#1F4E8C</field>
        <field name="sequence">1</field>
    </record>
    <record id="attribute_color_red" model="product.attribute.value">
        <field name="name">Rouge</field>
        <field name="attribute_id" ref="attribute_color"/>
        <field name="html_color">#B3261E</field>
        <field name="sequence">2</field>
    </record>
    <record id="attribute_size" model="product.attribute">
        <field name="name">Taille</field>
        <field name="display_type">pills</field>
        <field name="create_variant">always</field>
    </record>
    <record id="attribute_size_s" model="product.attribute.value">
        <field name="name">S</field>
