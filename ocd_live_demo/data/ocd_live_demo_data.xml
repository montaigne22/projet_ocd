        <field name="ocd_courier_kind">employee</field>
        <field name="ocd_courier_zone_ids" eval="[Command.set([ref('delivery_cameroon.district_douala_akwa'), ref('delivery_cameroon.district_douala_makepe'), ref('delivery_cameroon.district_douala_bonaberi')])]"/>
    </record>

    <!-- === Hosts of the remote lives === -->
    <record id="host_dzifa" model="hr.employee">
        <field name="name">Dzifa Agbeko</field>
        <field name="ocd_is_animatrice" eval="True"/>
    </record>
    <record id="host_kafui" model="hr.employee">
        <field name="name">Kafui Amedome</field>
        <field name="ocd_is_animatrice" eval="True"/>
    </record>

    <!-- === Price of the hours === -->
    <record id="price_rule_saturday_evening" model="ocd.live.price.rule">
        <field name="name">Samedi soir</field>
        <field name="percent">25</field>
        <field name="hour_from">17.5</field>
        <field name="hour_to">22</field>
        <field name="on_mon" eval="False"/>
        <field name="on_tue" eval="False"/>
        <field name="on_wed" eval="False"/>
        <field name="on_thu" eval="False"/>
        <field name="on_fri" eval="False"/>
        <field name="on_sun" eval="False"/>
    </record>
    <record id="price_rule_monday_morning" model="ocd.live.price.rule">
        <field name="name">Lundi matin</field>
        <field name="percent">-15</field>
        <field name="hour_from">8.5</field>
        <field name="hour_to">12</field>
        <field name="on_tue" eval="False"/>
        <field name="on_wed" eval="False"/>
        <field name="on_thu" eval="False"/>
        <field name="on_fri" eval="False"/>
        <field name="on_sat" eval="False"/>
        <field name="on_sun" eval="False"/>
    </record>

    <!-- === Products of the vendors === -->
    <record id="product_wax_dress" model="product.template">
        <field name="name">Robe en wax</field>
        <field name="type">consu</field>
        <field name="list_price">12000</field>
