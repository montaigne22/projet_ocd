        <field name="ocd_category_id" ref="ocd_live.category_clothes"/>
        <field name="ocd_business">Pagnes et robes en wax</field>
        <field name="phone">+237 670112202</field>
        <field name="country_id" ref="base.cm"/>
        <field name="city_id" ref="delivery_cameroon.city_cm_douala"/>
        <field name="district_id" ref="delivery_cameroon.district_douala_akwa"/>
        <field name="delivery_landmark">En face de la pharmacie du Port</field>
        <field name="ocd_whatsapp_optin" eval="True"/>
        <field name="ocd_sale_mode">ocd</field>
        <field name="ocd_delivery_mode">pickup</field>
        <field name="ocd_commission_rate">15</field>
    </record>
    <record id="vendor_fatou" model="res.partner">
