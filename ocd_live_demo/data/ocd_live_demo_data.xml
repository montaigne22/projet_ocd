        <field name="ocd_category_id" ref="ocd_live.category_home"/>
        <field name="ocd_business">Décoration et vaisselle</field>
        <field name="phone">+221 771122060</field>
        <field name="city">Dakar</field>
        <field name="country_id" ref="base.sn"/>
        <field name="ocd_sale_mode">direct</field>
    </record>
    <record id="vendor_mireille" model="res.partner">
        <field name="name">Mireille Couture</field>
        <field name="is_company" eval="True"/>
        <field name="ocd_is_vendor" eval="True"/>
        <field name="ocd_vendor_state">approved</field>
