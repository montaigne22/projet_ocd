    <!-- Two more checking windows between the morning and the evening ones: the team checks
         the links from 8:00 to 21:00, so that the directory has lives at any hour of a
         presentation, each live lasting about three hours as on TikTok -->
    <record id="window_midday" model="ocd.directory.window">
        <field name="name">Midday</field>
        <field name="start_hour">11</field>
        <field name="end_hour">14.5</field>
    </record>
    <record id="window_afternoon" model="ocd.directory.window">
        <field name="name">Afternoon</field>
        <field name="start_hour">14.5</field>
        <field name="end_hour">18</field>
    </record>

