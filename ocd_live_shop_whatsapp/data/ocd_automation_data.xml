<?xml version="1.0" encoding="utf-8"?>
<!-- The WhatsApp templates of the automations of the shop. -->
<odoo>

    <record id="ocd_live_shop.automation_parcel_split" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_to_prepare')])]"/>
    </record>
    <record id="ocd_live_shop.automation_parcel_escalation" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_reminder')])]"/>
    </record>
    <record id="ocd_live_shop.automation_code_sent" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_on_the_way')])]"/>
    </record>
    <record id="ocd_live_shop.automation_failed_return" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_failed'), ref('template_parcel_returned')])]"/>
    </record>
    <record id="ocd_live_shop.automation_delivered_message" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_delivered')])]"/>
    </record>
    <record id="ocd_live_shop.automation_boutique_alert" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_vendor_live')])]"/>
    </record>
    <record id="ocd_live_shop.automation_stock_alert" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_product_back')])]"/>
    </record>
    <record id="ocd_live_whatsapp.automation_asked" model="ocd.automation">
        <field name="template_ids" eval="[Command.link(ref('template_delivery_link'))]"/>
    </record>

</odoo>
