<?xml version="1.0" encoding="utf-8"?>
<!-- The WhatsApp templates of the automations of the shop. -->
<odoo>

    <record id="ocd_live_shop.automation_parcel_split" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_to_prepare'), ref('template_parcel_collect_to_prepare')])]"/>
    </record>
    <record id="ocd_live_shop.automation_parcel_escalation" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_reminder')])]"/>
    </record>
    <record id="ocd_live_shop.automation_code_sent" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_on_the_way')])]"/>
    </record>
    <record id="ocd_live_shop.automation_failed_return" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_failed'), ref('template_parcel_returned')])]"/>
    </record>
    <record id="ocd_live_shop.automation_delivered_message" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_delivered')])]"/>
    </record>
    <record id="ocd_live_shop.automation_boutique_alert" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_vendor_live')])]"/>
    </record>
    <record id="ocd_live_shop.automation_holiday_back" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_vendor_back')])]"/>
    </record>
    <record id="ocd_live_shop.automation_stock_alert" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_product_back'), ref('template_product_back_in_store')])]"/>
    </record>
    <record id="ocd_live_shop.automation_vendor_review" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_product_accepted'), ref('template_product_refused'),
                                                       ref('template_store_accepted'), ref('template_store_refused'),
                                                       ref('template_product_change_refused')])]"/>
    </record>
    <record id="ocd_live_shop.automation_collect" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_collect_ready'), ref('template_parcel_collect_reminder'),
                                                       ref('template_parcel_collect_expired')])]"/>
    </record>
    <record id="ocd_live_shop.automation_relay_arrived" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_relay_arrived'), ref('template_relay_incoming')])]"/>
    </record>
    <record id="ocd_live_shop.automation_relay_deadline" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_parcel_relay_reminder'), ref('template_parcel_relay_expired')])]"/>
    </record>
    <record id="ocd_live_shop.automation_hold" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_hold_requested'), ref('template_hold_accepted'),
                                                       ref('template_hold_refused')])]"/>
    </record>
    <record id="ocd_live_shop.automation_vendor_news" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_vendor_news')])]"/>
    </record>
    <record id="ocd_live_shop.automation_team" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_team_link'), ref('template_team_parcel'),
                                                       ref('template_team_hold')])]"/>
    </record>
    <record id="ocd_live_shop.automation_week_summary" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_week_summary')])]"/>
    </record>
    <record id="ocd_live_shop.automation_low_stock" model="ocd.automation">
        <field name="template_ids" eval="[Command.set([ref('template_stock_low')])]"/>
    </record>
    <record id="ocd_live_whatsapp.automation_asked" model="ocd.automation">
        <field name="template_ids" eval="[Command.link(ref('template_delivery_link'))]"/>
    </record>

</odoo>
