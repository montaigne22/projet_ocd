<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Templates to create at Meta (language French, category Utility) with the same names
         and texts, then to synchronise from the WhatsApp account. -->
    <data noupdate="1">

        <record id="template_delivery_link" model="whatsapp.template">
            <field name="name">OCD Live: link of the delivery app</field>
            <field name="template_name">ocd_lien_livraison</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="body">Bonjour {{1}}, voici vos colis OCD Live à préparer et à livrer. Touchez « Mes colis » pour les voir.</field>
            <field name="button_url_value">{{ 'ocd/livrer/' + object._ocd_get_space_token() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Mes colis', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/livrer/AbC123'})]"/>
            <field name="variable_ids" eval="[(0, 0, {'sequence': 1, 'value': '{{ object.name }}', 'sample_value': 'Junior'})]"/>
        </record>

        <record id="template_parcel_to_prepare" model="whatsapp.template">
            <field name="name">OCD Live: parcel to prepare</field>
            <field name="template_name">ocd_colis_a_preparer</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="partner_field">ocd_vendor_id</field>
            <field name="body">Bonjour {{1}}, nouveau colis à préparer pour {{2}}, à livrer à {{3}}. Contenu : {{4}}. Touchez le bouton quand il est prêt.</field>
            <field name="button_url_value">{{ 'ocd/livrer/' + object.ocd_vendor_id._ocd_get_space_token() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Mes colis', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/livrer/AbC123'})]"/>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.ocd_vendor_id.name }}', 'sample_value': 'Fatou'}),
                (0, 0, {'sequence': 2, 'value': '{{ object.partner_id.name }}', 'sample_value': 'Estelle'}),
                (0, 0, {'sequence': 3, 'value': '{{ object.ocd_district_id.name or object.partner_id.city or \'\' }}', 'sample_value': 'Akwa'}),
                (0, 0, {'sequence': 4, 'value': '{{ \', \'.join(object.move_ids.mapped(\'product_id.name\')) }}', 'sample_value': 'Beurre de karité'}),
            ]"/>
        </record>

        <record id="template_parcel_reminder" model="whatsapp.template">
            <field name="name">OCD Live: parcel not ready</field>
            <field name="template_name">ocd_colis_rappel</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="partner_field">ocd_vendor_id</field>
            <field name="body">Bonjour {{1}}, le colis de {{2}} n'est pas encore prêt. Le client attend : préparez-le et touchez le bouton.</field>
            <field name="button_url_value">{{ 'ocd/livrer/' + object.ocd_vendor_id._ocd_get_space_token() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Mes colis', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/livrer/AbC123'})]"/>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.ocd_vendor_id.name }}', 'sample_value': 'Patrick'}),
                (0, 0, {'sequence': 2, 'value': '{{ object.partner_id.name }}', 'sample_value': 'Didier'}),
            ]"/>
        </record>

        <record id="template_parcel_on_the_way" model="whatsapp.template">
            <field name="name">OCD Live: parcel on the way</field>
            <field name="template_name">ocd_colis_en_route</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="partner_field">partner_id</field>
            <!-- The code of the parcel is neither in the message nor named in it (Meta takes a
                 code in a Utility template for an authentication): the button opens the page that
                 follows the order, where the code is -->
            <field name="body">Bonjour {{1}}, votre colis {{2}} est en route avec {{3}}. Le livreur vous appellera avant de passer. Touchez « Suivre mon colis » pour suivre la livraison.</field>
            <field name="button_url_value">{{ object._ocd_tracking_path() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Suivre mon colis', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/suivi/12?access_token=abc123'})]"/>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.partner_id.name }}', 'sample_value': 'Estelle'}),
                (0, 0, {'sequence': 2, 'value': '{{ \', \'.join(object.move_ids.mapped(\'product_id.name\')) }}', 'sample_value': 'Robe en wax'}),
                (0, 0, {'sequence': 3, 'value': '{{ object.ocd_courier_id.name }}', 'sample_value': 'Junior'}),
            ]"/>
        </record>

        <record id="template_parcel_failed" model="whatsapp.template">
            <field name="name">OCD Live: delivery not possible</field>
            <field name="template_name">ocd_colis_echec</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="partner_field">partner_id</field>
            <field name="body">Bonjour {{1}}, votre colis n'a pas pu vous être livré par {{2}}. Répondez à ce message pour choisir un autre moment de livraison.</field>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.partner_id.name }}', 'sample_value': 'Arnaud'}),
                (0, 0, {'sequence': 2, 'value': '{{ object.ocd_courier_id.name or \'Le livreur\' }}', 'sample_value': 'Raoul'}),
            ]"/>
        </record>

        <record id="template_parcel_delivered" model="whatsapp.template">
            <field name="name">OCD Live: parcel delivered</field>
            <field name="template_name">ocd_colis_livre</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="partner_field">partner_id</field>
            <field name="body">Bonjour {{1}}, votre colis {{2}} est livré. Merci pour votre confiance !</field>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.partner_id.name }}', 'sample_value': 'Estelle'}),
                (0, 0, {'sequence': 2, 'value': '{{ \', \'.join(object.move_ids.mapped(\'product_id.name\')) }}', 'sample_value': 'Robe en wax'}),
            ]"/>
        </record>

        <record id="template_parcel_returned" model="whatsapp.template">
            <field name="name">OCD Live: parcel returned</field>
            <field name="template_name">ocd_colis_retour</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="partner_field">partner_id</field>
            <field name="body">Bonjour {{1}}, votre colis {{2}} n'a pas pu être livré et retourne chez le vendeur. L'équipe OCD Live vous contacte pour la suite.</field>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.partner_id.name }}', 'sample_value': 'Arnaud'}),
                (0, 0, {'sequence': 2, 'value': '{{ \', \'.join(object.move_ids.mapped(\'product_id.name\')) }}', 'sample_value': 'Coffret soins'}),
            ]"/>
        </record>

        <record id="template_vendor_live" model="whatsapp.template">
            <field name="name">OCD Live: the vendor is live</field>
            <field name="template_name">ocd_vendeur_en_live</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="ocd_live_shop.model_ocd_boutique_alert"/>
            <field name="partner_field">partner_id</field>
            <field name="body">Bonjour, {{1}} est en live maintenant. Touchez le bouton pour voir le live et sa boutique sur OCD Live.</field>
            <field name="button_url_value">{{ 'ocd/boutique/%s' % object.vendor_id.id }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Voir la boutique', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/boutique/12'})]"/>
            <field name="variable_ids" eval="[(0, 0, {'sequence': 1, 'value': '{{ object.vendor_id.name }}', 'sample_value': 'Brenda Wax'})]"/>
        </record>

        <!-- The vendor is back from holiday (chantier 20): the customers who asked « Tell me when
             they are back » -->
        <record id="template_vendor_back" model="whatsapp.template">
            <field name="name">OCD Live: vendor back from holiday</field>
            <field name="template_name">ocd_vendeur_de_retour</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="ocd_live_shop.model_ocd_boutique_alert"/>
            <field name="partner_field">partner_id</field>
            <field name="body">Bonne nouvelle : {{1}} est de retour sur OCD Live et reprend les commandes. Touchez le bouton pour voir sa boutique.</field>
            <field name="button_url_value">{{ 'ocd/boutique/%s' % object.vendor_id.id }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Voir la boutique', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/boutique/12'})]"/>
            <field name="variable_ids" eval="[(0, 0, {'sequence': 1, 'value': '{{ object.vendor_id.name }}', 'sample_value': 'Awa Couture'})]"/>
        </record>

        <!-- Back in stock: no variable at the start nor at the end, words between them (rules of Meta) -->
        <record id="template_product_back" model="whatsapp.template">
            <field name="name">OCD Live: product back in stock</field>
            <field name="template_name">ocd_produit_de_retour</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="ocd_live_shop.model_ocd_stock_alert"/>
            <field name="partner_field">partner_id</field>
            <field name="body">Bonne nouvelle : {{1}} est de nouveau disponible en {{2}} sur OCD Live. Touchez le bouton pour le commander avant qu'il ne reparte.</field>
            <field name="button_url_value">{{ object._ocd_product_path() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Voir le produit', 'url': '{base_url}/{{1}}', 'url_example': 'shop/robe-en-wax-20?v=12,15'})]"/>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.product_id.product_tmpl_id.name }}', 'sample_value': 'Robe en wax'}),
                (0, 0, {'sequence': 2, 'value': '{{ object._ocd_variant_label() }}', 'sample_value': 'Bleu, L'}),
            ]"/>
        </record>

        <!-- Back in stock, with the stores of the vendor where it came back (chantier 18): sent
             instead of the message above once Meta approved it -->
        <record id="template_product_back_in_store" model="whatsapp.template">
            <field name="name">OCD Live: product back in stock, in store</field>
            <field name="template_name">ocd_produit_de_retour_magasin</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="ocd_live_shop.model_ocd_stock_alert"/>
            <field name="partner_field">partner_id</field>
            <field name="body">Bonne nouvelle : {{1}} est de nouveau disponible en {{2}} sur OCD Live, aussi en magasin : {{3}}. Touchez le bouton pour le commander avant qu'il ne reparte.</field>
            <field name="button_url_value">{{ object._ocd_product_path() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Voir le produit', 'url': '{base_url}/{{1}}', 'url_example': 'shop/robe-en-wax-20?v=12,15'})]"/>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.product_id.product_tmpl_id.name }}', 'sample_value': 'Robe en wax'}),
                (0, 0, {'sequence': 2, 'value': '{{ object._ocd_variant_label() }}', 'sample_value': 'Bleu, L'}),
                (0, 0, {'sequence': 3, 'value': '{{ object._ocd_back_in_stores() }}', 'sample_value': 'Akwa, Marché central'}),
            ]"/>
        </record>

        <!-- The checks of the team, told to the vendor (plan of « My products », 2.4 and 3.4). The
             button opens « My products » on the phone of the vendor. -->
        <record id="template_product_accepted" model="whatsapp.template">
            <field name="name">OCD Live: product accepted</field>
            <field name="template_name">ocd_produit_accepte</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="partner_field">ocd_vendor_id</field>
            <field name="body">Bonjour {{1}}, votre produit {{2}} est accepté : il est maintenant visible dans votre boutique OCD Live. Touchez « Mes produits » pour le voir.</field>
            <field name="button_url_value">{{ object._ocd_vendor_products_path() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Mes produits', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/espace/AbC123/produits'})]"/>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.ocd_vendor_id.name }}', 'sample_value': 'Awa'}),
                (0, 0, {'sequence': 2, 'value': '{{ object.name }}', 'sample_value': 'Robe en wax'}),
            ]"/>
        </record>

        <record id="template_product_refused" model="whatsapp.template">
            <field name="name">OCD Live: product refused</field>
            <field name="template_name">ocd_produit_refuse</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="partner_field">ocd_vendor_id</field>
            <field name="body">Bonjour {{1}}, votre produit {{2}} n'est pas encore en ligne, pour ce motif : {{3}}. Touchez « Mes produits » pour le corriger et le renvoyer à l'équipe.</field>
            <field name="button_url_value">{{ object._ocd_vendor_products_path() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Mes produits', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/espace/AbC123/produits'})]"/>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.ocd_vendor_id.name }}', 'sample_value': 'Awa'}),
                (0, 0, {'sequence': 2, 'value': '{{ object.name }}', 'sample_value': 'Robe en wax'}),
                (0, 0, {'sequence': 3, 'value': '{{ object.ocd_refuse_reason_id.name }}', 'sample_value': 'Photo floue'}),
            ]"/>
        </record>

        <!-- The change of a product on sale refused (chantier 19): the product stays on sale as
             it was -->
        <record id="template_product_change_refused" model="whatsapp.template">
            <field name="name">OCD Live: change of a product refused</field>
            <field name="template_name">ocd_modification_refusee</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="partner_field">ocd_vendor_id</field>
            <field name="body">Bonjour {{1}}, la modification de votre produit {{2}} n'est pas acceptée, pour cette raison : {{3}}. Votre produit reste en vente comme avant. Touchez « Mes produits » pour la corriger et la renvoyer.</field>
            <field name="button_url_value">{{ object._ocd_vendor_products_path() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Mes produits', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/espace/AbC123/produits'})]"/>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.ocd_vendor_id.name }}', 'sample_value': 'Awa'}),
                (0, 0, {'sequence': 2, 'value': '{{ object.name }}', 'sample_value': 'Robe en wax'}),
                (0, 0, {'sequence': 3, 'value': '{{ object.ocd_change_reason_id.name }}', 'sample_value': 'Nom qui ne décrit pas le produit'}),
            ]"/>
        </record>

        <!-- The check of a store by the team (M.5 of the plan), told to the vendor. The button
             opens « My stores » on the phone of the vendor. -->
        <record id="template_store_accepted" model="whatsapp.template">
            <field name="name">OCD Live: store accepted</field>
            <field name="template_name">ocd_magasin_accepte</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="ocd_live_shop.model_ocd_vendor_place"/>
            <field name="partner_field">vendor_id</field>
            <field name="body">Bonjour {{1}}, votre magasin {{2}} est vérifié : vos clients le voient maintenant dans votre boutique OCD Live, avec l'itinéraire. Touchez « Mes magasins » pour le voir.</field>
            <field name="button_url_value">{{ object._ocd_vendor_places_path() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Mes magasins', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/espace/AbC123/magasins'})]"/>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.vendor_id.name }}', 'sample_value': 'Awa'}),
                (0, 0, {'sequence': 2, 'value': '{{ object.name }}', 'sample_value': 'Awa Couture Akwa'}),
            ]"/>
        </record>

        <record id="template_store_refused" model="whatsapp.template">
            <field name="name">OCD Live: store refused</field>
            <field name="template_name">ocd_magasin_refuse</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="ocd_live_shop.model_ocd_vendor_place"/>
            <field name="partner_field">vendor_id</field>
            <field name="body">Bonjour {{1}}, votre magasin {{2}} n'est pas encore visible, pour ce motif : {{3}}. Touchez « Mes magasins » pour le corriger et le renvoyer à l'équipe.</field>
            <field name="button_url_value">{{ object._ocd_vendor_places_path() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Mes magasins', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/espace/AbC123/magasins'})]"/>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.vendor_id.name }}', 'sample_value': 'Awa'}),
                (0, 0, {'sequence': 2, 'value': '{{ object.name }}', 'sample_value': 'Awa Couture Akwa'}),
                (0, 0, {'sequence': 3, 'value': '{{ object.refuse_reason_id.name }}', 'sample_value': 'Enseigne pas visible'}),
            ]"/>
        </record>

        <record id="template_stock_low" model="whatsapp.template">
            <field name="name">OCD Live: stock low</field>
            <field name="template_name">ocd_stock_bas</field>
            <field name="lang_code">fr</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="partner_field">ocd_vendor_id</field>
            <field name="body">Bonjour {{1}}, il ne reste que {{2}} pièce(s) de {{3}} dans votre boutique OCD Live. Touchez « Mes produits » pour remettre du stock.</field>
            <field name="button_url_value">{{ object._ocd_vendor_products_path() }}</field>
            <field name="button_ids" eval="[(0, 0, {'button_type': 'url', 'name': 'Mes produits', 'url': '{base_url}/{{1}}', 'url_example': 'ocd/espace/AbC123/produits'})]"/>
            <field name="variable_ids" eval="[
                (0, 0, {'sequence': 1, 'value': '{{ object.ocd_vendor_id.name }}', 'sample_value': 'Awa'}),
                (0, 0, {'sequence': 2, 'value': '{{ object._ocd_free_total() }}', 'sample_value': '2'}),
                (0, 0, {'sequence': 3, 'value': '{{ object.name }}', 'sample_value': 'Robe en wax'}),
            ]"/>
        </record>

    </data>
</odoo>
