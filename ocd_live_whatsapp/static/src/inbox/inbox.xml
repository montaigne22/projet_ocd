<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ocd_live_whatsapp.Inbox">
        <div class="o_action o_ocd_bo o_ocd_inbox" t-ref="this.rootRef">
            <t t-set="data" t-value="this.data()"/>
            <t t-set="current" t-value="this.current"/>
            <div class="o_ocd_bo_header">
                <h1 class="o_ocd_bo_title">Conversations</h1>
                <span t-attf-class="o_ocd_bo_pager o_ocd_bo_push o_ocd_wa_account o_ocd_wa_tone_#{data.account.tone}"
                      t-out="data.account.text"/>
                <button type="button" class="btn o_ocd_bo_icon_button" t-on-click="() => this.refresh()"
                        title="Refresh" aria-label="Refresh">
                    <i class="oi" data-icon="refresh" aria-hidden="true"/>
                </button>
            </div>
            <div class="o_ocd_wa">
                <div t-attf-class="o_ocd_wa_box o_ocd_wa_pane_#{current ? this.pane() : 'list'} #{this.tab() === 'contact' ? 'o_ocd_wa_show_contact' : ''}">
                    <!-- Conversations -->
                    <div class="o_ocd_wa_list">
                        <div class="o_ocd_wa_search">
                            <i class="oi" data-icon="search" aria-hidden="true"/>
                            <label for="o_ocd_wa_search" class="visually-hidden">Search a name or a number</label>
                            <input id="o_ocd_wa_search" type="search" class="o_ocd_wa_search_input" autocomplete="off"
                                   placeholder="Name or number…" t-att-value="this.search()"
                                   t-on-input="(ev) => this.onSearch(ev)"/>
                            <button t-if="this.search()" type="button" class="o_ocd_wa_search_clear"
                                    title="Clear the search" aria-label="Clear the search" t-on-click="() => this.clearSearch()">
                                <i class="oi" data-icon="close" aria-hidden="true"/>
                            </button>
                        </div>
                        <div class="o_ocd_wa_chips" role="group" aria-label="Filter the conversations">
                            <button t-foreach="this.chips" t-as="chip" t-key="chip.key" type="button" class="o_ocd_wa_chip"
                                    t-att-aria-pressed="this.filter() === chip.key ? 'true' : 'false'"
                                    t-on-click="() => this.setFilter(chip.key)" t-out="chip.label"/>
                        </div>
                        <div class="o_ocd_wa_items">
                            <button t-foreach="this.conversations" t-as="conversation" t-key="conversation.id" type="button"
                                    t-att-class="{ 'o_ocd_wa_item': true, 'o_ocd_current': current and current.id === conversation.id, 'o_ocd_waiting': conversation.waiting, 'o_ocd_wa_item_done': conversation.done }"
                                    t-att-aria-pressed="current and current.id === conversation.id ? 'true' : 'false'"
                                    t-on-click="() => this.open(conversation)">
                                <span t-attf-class="o_ocd_wa_avatar #{conversation.vendor ? 'o_ocd_wa_avatar_vendor' : ''}"
                                      aria-hidden="true" t-out="conversation.initials"/>
                                <span class="o_ocd_wa_item_text">
                                    <span class="o_ocd_wa_item_top">
                                        <span class="o_ocd_wa_item_name" t-out="conversation.name"/>
                                        <span class="o_ocd_wa_item_role" t-out="conversation.role"/>
                                    </span>
                                    <span class="o_ocd_wa_item_preview" t-out="conversation.preview"/>
                                </span>
                                <span class="o_ocd_wa_item_side">
                                    <span class="o_ocd_wa_item_time" t-out="conversation.time"/>
                                    <span t-if="conversation.window_left"
                                          t-attf-class="o_ocd_wa_left #{conversation.window_urgent ? 'o_ocd_wa_left_urgent' : ''}"
                                          title="Time left to answer for free (24 hours after the last message)">
                                        <i class="oi" data-icon="schedule" aria-hidden="true"/><t t-out="conversation.window_left"/>
                                    </span>
                                    <span t-elif="conversation.waiting" class="o_ocd_wa_dot" role="img"
                                          aria-label="Waiting for an answer"/>
                                    <span t-elif="conversation.done" class="o_ocd_wa_done_mark" title="Resolved">
                                        <i class="oi" data-icon="check" aria-hidden="true"/>
                                    </span>
                                </span>
                            </button>
                            <p t-if="!this.conversations.length" class="o_ocd_wa_empty" t-out="this.emptyText"/>
                            <button t-if="data.has_more" type="button" class="o_ocd_wa_more" t-on-click="() => this.showMore()">
                                Show more conversations
                            </button>
                        </div>
                        <div t-if="data.team_channels.length" class="o_ocd_wa_team">
                            <span class="o_ocd_wa_team_title">Channels of the team · Discuss</span>
                            <button t-foreach="data.team_channels" t-as="row" t-key="row_index" type="button"
                                    class="o_ocd_wa_team_row" t-on-click="() => this.openTeamChannel(row)">
                                <span class="o_ocd_wa_team_name" t-out="row.name"/>
                                <span t-attf-class="o_ocd_wa_team_text o_ocd_wa_tone_#{row.tone or 'none'}"
                                      t-out="row.time ? row.text + ' · ' + row.time : row.text"/>
                            </button>
                        </div>
                    </div>

                    <!-- Conversation -->
                    <div class="o_ocd_wa_thread">
                        <t t-if="current">
                            <t t-call="ocd_live_whatsapp.InboxTabs"/>
                            <div class="o_ocd_wa_head">
                                <span class="o_ocd_wa_head_text">
                                    <b class="o_ocd_wa_head_name" t-out="current.name"/>
                                    <span class="o_ocd_wa_head_sub">
                                        <t t-out="current.phone"/> · <t t-out="current.role"/>
                                    </span>
                                </span>
                                <div class="o_ocd_wa_actions">
                                    <span t-attf-class="o_ocd_wa_state o_ocd_wa_state_#{current.state}" t-out="current.state_label"/>
                                    <button t-if="!current.mine and current.state !== 'done'" type="button"
                                            class="o_ocd_wa_action o_ocd_wa_action_main" t-att-disabled="this.busy()"
                                            title="You handle this conversation: the other agents leave it"
                                            t-on-click="() => this.take()">
                                        <i class="oi" data-icon="person_add" aria-hidden="true"/> Take
                                    </button>
                                    <button t-if="current.state !== 'done'" type="button" class="o_ocd_wa_action"
                                            t-att-disabled="this.busy()" title="Nobody waits any more: a new message of the contact opens it again"
                                            t-on-click="() => this.resolve()">
                                        <i class="oi" data-icon="task_alt" aria-hidden="true"/> Mark as resolved
                                    </button>
                                    <button t-else="" type="button" class="o_ocd_wa_action" t-att-disabled="this.busy()"
                                            t-on-click="() => this.reopen()">
                                        <i class="oi" data-icon="undo" aria-hidden="true"/> Reopen
                                    </button>
                                </div>
                                <span t-attf-class="o_ocd_wa_window #{current.open ? (current.window_urgent ? 'o_ocd_wa_window_urgent' : 'o_ocd_wa_window_open') : 'o_ocd_wa_window_closed'}">
                                    <i t-if="current.open" class="oi" data-icon="schedule" aria-hidden="true"/>
                                    <t t-out="current.window"/>
                                </span>
                                <t t-if="current.calls">
                                    <button t-if="current.calls.allowed" type="button" class="o_ocd_wa_call_button"
                                            t-att-disabled="this.busy()" t-att-title="current.calls.text"
                                            t-on-click="() => this.callCustomer()">
                                        <i class="oi" data-icon="phone" aria-hidden="true"/> Call
                                    </button>
                                    <button t-elif="current.calls.can_ask" type="button" class="o_ocd_wa_call_button o_ocd_wa_call_ask"
                                            t-att-disabled="this.busy()" t-att-title="current.calls.text"
                                            t-on-click="() => this.askToCall()">
                                        <i class="oi" data-icon="add_call" aria-hidden="true"/> Ask to call them
                                    </button>
                                    <span t-else="" class="o_ocd_wa_call_none" t-att-title="current.calls.text">
                                        <i class="oi" data-icon="phone" aria-hidden="true"/> Not allowed to call
                                    </span>
                                </t>
                            </div>
                            <div class="o_ocd_wa_messages" t-ref="this.messagesRef" role="log" aria-live="polite"
                                 t-att-aria-label="current.name" t-on-scroll="() => this.onMessagesScroll()"
                                 t-on-load.capture="() => this.onMediaLoaded()"
                                 t-on-loadedmetadata.capture="() => this.onMediaLoaded()">
                                <div t-foreach="current.messages" t-as="message" t-key="message.id"
                                     t-attf-class="o_ocd_wa_line o_ocd_wa_line_#{message.kind}">
                                    <!-- a call: a line of its own, like in WhatsApp -->
                                    <div t-if="message.call" t-attf-class="o_ocd_wa_call #{message.call.missed ? 'o_ocd_wa_call_missed' : ''}">
                                        <i class="oi o_ocd_wa_call_icon" t-att-data-icon="this.callIcon(message.call)" aria-hidden="true"/>
                                        <span class="o_ocd_wa_call_text" t-out="message.text"/>
                                        <span class="o_ocd_wa_meta" t-out="message.time"/>
                                        <span t-if="(message.call.call_back and current.calls) or message.call.recording" class="o_ocd_wa_call_actions">
                                            <button t-if="message.call.call_back and current.calls" type="button" class="o_ocd_wa_call_link"
                                                    t-att-disabled="this.busy()" t-on-click="() => this.callCustomer()">
                                                <i class="oi" data-icon="phone_callback" aria-hidden="true"/> Call back
                                            </button>
                                            <button t-if="message.call.recording" type="button" class="o_ocd_wa_call_link"
                                                    t-on-click="() => this.listenRecording(message.call)">
                                                <i class="oi" data-icon="play_arrow" aria-hidden="true"/> Listen to the recording
                                            </button>
                                        </span>
                                    </div>
                                    <div t-else="" t-attf-class="o_ocd_wa_bubble o_ocd_wa_bubble_#{message.kind} #{message.failed ? 'o_ocd_wa_bubble_failed' : ''}">
                                        <span t-if="message.tag" class="o_ocd_wa_tag" t-out="message.tag"/>
                                        <div t-if="message.files.length" class="o_ocd_wa_files">
                                            <div t-foreach="message.files" t-as="file" t-key="file.id" class="o_ocd_wa_file">
                                                <WhatsAppAttachment file="file" open="() => this.openFile(file, message.files)"/>
                                            </div>
                                        </div>
                                        <span t-if="message.text" class="o_ocd_wa_text" t-out="message.text"/>
                                        <span class="o_ocd_wa_meta">
                                            <t t-out="message.time"/><t t-if="message.status"> · <t t-out="message.status"/></t>
                                        </span>
                                    </div>
                                </div>
                                <p t-if="!current.messages.length" class="o_ocd_wa_empty">No message yet.</p>
                            </div>
                            <div t-if="current.open" class="o_ocd_wa_compose">
                                <div t-if="current.quick.length" class="o_ocd_wa_quick">
                                    <span class="o_ocd_wa_quick_title">Quick answers</span>
                                    <button t-foreach="current.quick" t-as="quick" t-key="quick_index" type="button"
                                            class="o_ocd_wa_quick_button" t-att-title="quick.text"
                                            t-on-click="() => this.useQuick(quick)" t-out="quick.label"/>
                                </div>
                                <t t-call="ocd_live_whatsapp.InboxFiles"/>
                                <div class="o_ocd_wa_write">
                                    <t t-call="ocd_live_whatsapp.InboxAttach"/>
                                    <label for="o_ocd_wa_draft" class="visually-hidden">Message to <t t-out="current.name"/></label>
                                    <textarea id="o_ocd_wa_draft" class="o_ocd_wa_input" rows="1" t-ref="this.inputRef"
                                              placeholder="Write a message…" t-att-value="this.draft()"
                                              t-on-input="(ev) => this.onDraft(ev)" t-on-keydown="(ev) => this.onKeydown(ev)"/>
                                    <button type="button" class="o_ocd_wa_note_button" t-att-disabled="!this.canPost"
                                            t-on-click="() => this.post(true)">Internal note</button>
                                    <button type="button" class="o_ocd_wa_send" t-att-disabled="!this.canPost"
                                            t-on-click="() => this.post(false)">Send</button>
                                </div>
                            </div>
                            <div t-else="" class="o_ocd_wa_compose">
                                <t t-if="current.templates.length">
                                    <label for="o_ocd_wa_template" class="o_ocd_wa_quick_title">Template approved by Meta</label>
                                    <select id="o_ocd_wa_template" class="o_ocd_wa_select" t-on-change="(ev) => this.onTemplate(ev)">
                                        <option t-foreach="current.templates" t-as="template" t-key="template.key"
                                                t-att-value="template.key"
                                                t-att-selected="template.key === this.templateKey() ? 'selected' : undefined"
                                                t-out="template.label"/>
                                    </select>
                                    <div t-if="this.template" class="o_ocd_wa_preview" t-out="this.template.preview"/>
                                    <button type="button" class="o_ocd_wa_send o_ocd_wa_send_template" t-att-disabled="this.busy()"
                                            t-on-click="() => this.sendTemplate()">Send the template</button>
                                </t>
                                <p t-else="" class="o_ocd_wa_empty">No approved template for this contact: they write first, then the team answers.</p>
                                <!-- an internal note: at any time, never sent to the contact -->
                                <t t-call="ocd_live_whatsapp.InboxFiles"/>
                                <div class="o_ocd_wa_write o_ocd_wa_write_note">
                                    <t t-call="ocd_live_whatsapp.InboxAttach"/>
                                    <label for="o_ocd_wa_note" class="visually-hidden">Internal note</label>
                                    <textarea id="o_ocd_wa_note" class="o_ocd_wa_input" rows="1"
                                              placeholder="Internal note for the team (not sent)…" t-att-value="this.draft()"
                                              t-on-input="(ev) => this.onDraft(ev)" t-on-keydown="(ev) => this.onKeydown(ev, true)"/>
                                    <button type="button" class="o_ocd_wa_note_button" t-att-disabled="!this.canPost"
                                            t-on-click="() => this.post(true)">Internal note</button>
                                </div>
                            </div>
                        </t>
                        <p t-else="" class="o_ocd_wa_empty o_ocd_wa_empty_center">Choose a conversation.</p>
                    </div>

                    <!-- Contact -->
                    <aside class="o_ocd_wa_contact" t-if="current">
                        <t t-call="ocd_live_whatsapp.InboxTabs"/>
                        <div class="o_ocd_wa_contact_head">
                            <span t-attf-class="o_ocd_wa_avatar o_ocd_wa_avatar_big #{current.vendor ? 'o_ocd_wa_avatar_vendor' : ''}"
                                  aria-hidden="true" t-out="current.initials"/>
                            <span class="o_ocd_wa_contact_names">
                                <b t-out="current.name"/>
                                <span t-out="current.place"/>
                            </span>
                        </div>
                        <div t-attf-class="o_ocd_wa_consent o_ocd_wa_consent_#{current.consent.tone}">
                            <b t-out="current.consent.text"/>
                            <span>If they write STOP, no automatic message any more.</span>
                        </div>
                        <t t-foreach="current.sections" t-as="section" t-key="section_index">
                            <span class="o_ocd_wa_section_title" t-out="section.title"/>
                            <div t-foreach="section.rows" t-as="row" t-key="row_index" class="o_ocd_wa_row">
                                <span class="o_ocd_wa_row_key" t-out="row.key"/>
                                <span class="o_ocd_wa_row_value" t-out="row.value"/>
                            </div>
                            <div class="o_ocd_wa_links">
                                <button t-foreach="section.links" t-as="link" t-key="link_index" type="button"
                                        class="o_ocd_wa_link" t-on-click="() => this.run(link.action)">
                                    <t t-out="link.label"/><span aria-hidden="true">→</span>
                                </button>
                            </div>
                        </t>
                        <div class="o_ocd_wa_links">
                            <button t-if="current.partner_action" type="button" class="o_ocd_wa_link"
                                    t-on-click="() => this.run(current.partner_action)">Contact<span aria-hidden="true">→</span></button>
                            <button type="button" class="o_ocd_wa_link" t-on-click="() => this.openDiscuss()">
                                Open in Discuss<span aria-hidden="true">→</span></button>
                        </div>
                        <p class="o_ocd_wa_foot">The delivery codes are hidden here: only the customer sees them.</p>
                    </aside>
                </div>
            </div>
        </div>
    </t>
    <!-- On a phone or a tablet: the conversation, or the contact with their calls -->
    <t t-name="ocd_live_whatsapp.InboxTabs">
        <div class="o_ocd_wa_tabs" role="tablist" aria-label="Conversation or contact">
            <button type="button" class="o_ocd_wa_back" title="Back to the conversations"
                    aria-label="Back to the conversations" t-on-click="() => this.back()">
                <i class="oi" data-icon="arrow_back" aria-hidden="true"/>
            </button>
            <button type="button" role="tab" class="o_ocd_wa_tab" t-att-aria-selected="this.tab() === 'thread' ? 'true' : 'false'"
                    t-on-click="() => this.tab.set('thread')">
                <i class="oi" data-icon="chat_bubble" aria-hidden="true"/> Conversation
            </button>
            <button type="button" role="tab" class="o_ocd_wa_tab" t-att-aria-selected="this.tab() === 'contact' ? 'true' : 'false'"
                    t-on-click="() => this.tab.set('contact')">
                <i class="oi" data-icon="contact_page" aria-hidden="true"/>
                <t t-if="current.calls">Contact and calls</t><t t-else="">Contact</t>
            </button>
        </div>
    </t>

    <!-- The files that leave with the next message, and the upload in progress -->
    <t t-name="ocd_live_whatsapp.InboxFiles">
        <div t-if="this.files().length or this.uploading() or this.voice.recording" class="o_ocd_wa_pending">
            <span t-foreach="this.files()" t-as="file" t-key="file.id" class="o_ocd_wa_pending_file">
                <i class="oi" t-att-data-icon="this.fileIcon(file)" aria-hidden="true"/>
                <span class="o_ocd_wa_pending_name" t-out="file.name" t-att-title="file.name"/>
                <button type="button" class="o_ocd_wa_pending_remove" title="Remove the file"
                        aria-label="Remove the file" t-on-click="() => this.removeFile(file)">
                    <i class="oi" data-icon="close" aria-hidden="true"/>
                </button>
            </span>
            <span t-if="this.uploading()" class="o_ocd_wa_pending_file o_ocd_wa_pending_busy">
                <i class="oi" data-icon="upload" aria-hidden="true"/> Adding the file…
            </span>
            <span t-if="this.voice.recording" class="o_ocd_wa_pending_file o_ocd_wa_recording" role="status">
                <span class="o_ocd_wa_recording_dot" aria-hidden="true"/>
                <t t-out="this.voice.elapsed"/>
                <button type="button" class="o_ocd_wa_pending_remove" title="Cancel the voice message"
                        aria-label="Cancel the voice message" t-on-click="() => this.voice.cancelRecording()">
                    <i class="oi" data-icon="close" aria-hidden="true"/>
                </button>
            </span>
        </div>
    </t>

    <!-- Add a photo or a document, record a voice message -->
    <t t-name="ocd_live_whatsapp.InboxAttach">
        <input type="file" class="d-none" multiple="multiple" t-ref="this.fileInputRef"
               accept="image/*,video/*,audio/*,application/pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip"
               t-on-change="(ev) => this.onFilesChosen(ev)"/>
        <button type="button" class="o_ocd_wa_tool" title="Add a photo or a document" aria-label="Add a photo or a document"
                t-att-disabled="this.busy() or this.voice.recording" t-on-click="() => this.chooseFiles()">
            <i class="oi" data-icon="attach_file" aria-hidden="true"/>
        </button>
        <button type="button" t-attf-class="o_ocd_wa_tool #{this.voice.recording ? 'o_ocd_wa_tool_recording' : ''}"
                t-att-title="this.voiceTitle" t-att-aria-label="this.voiceTitle"
                t-att-disabled="this.busy()" t-on-click="() => this.toggleVoice()">
            <i class="oi" t-att-data-icon="this.voice.recording ? 'stop' : 'mic'" aria-hidden="true"/>
        </button>
    </t>

</templates>
