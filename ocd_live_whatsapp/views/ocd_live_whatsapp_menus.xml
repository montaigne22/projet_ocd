<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="ocd_live_whatsapp_menu" name="WhatsApp" parent="ocd_live.ocd_live_menu_root" sequence="50"/>
    <!-- Conversations as in the validated design (BoWhatsApp), on those of whatsapp_cloud -->
    <record id="ocd_whatsapp_inbox_action" model="ir.actions.client">
        <field name="name">Conversations</field>
        <field name="tag">ocd_live_whatsapp.inbox</field>
    </record>

    <menuitem id="ocd_live_whatsapp_conversations_menu" name="Conversations" parent="ocd_live_whatsapp_menu"
              action="ocd_whatsapp_inbox_action" sequence="10" groups="whatsapp_cloud.group_whatsapp_user"/>
    <menuitem id="ocd_live_whatsapp_conversation_list_menu" name="All the conversations" parent="ocd_live_whatsapp_menu"
              action="whatsapp_cloud.discuss_channel_action_whatsapp" sequence="15" groups="whatsapp_cloud.group_whatsapp_user"/>
    <menuitem id="ocd_live_whatsapp_templates_menu" name="Automatic messages" parent="ocd_live_whatsapp_menu"
              action="whatsapp_cloud.whatsapp_template_action" sequence="20"/>

</odoo>
