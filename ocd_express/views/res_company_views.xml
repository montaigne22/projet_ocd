<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The cities open to OCD Express, on the company (the other settings are on the settings page) -->
    <record id="view_company_form_ocd_express" model="ir.ui.view">
        <field name="name">res.company.form.ocd.express</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="ocd_express" string="OCD Express">
                    <group>
                        <field name="ocd_express_city_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
