<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ocd_vote_contest_view_list" model="ir.ui.view">
        <field name="name">ocd.vote.contest.list</field>
        <field name="model">ocd.vote.contest</field>
        <field name="arch" type="xml">
            <list string="Contests" decoration-muted="state in ('done', 'cancelled')" decoration-warning="state == 'to_check'">
                <field name="name"/>
                <field name="organizer_id" optional="show"/>
                <field name="date_close"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'to_check'"/>
                <field name="vote_count" sum="Votes"/>
                <field name="amount_total" sum="Collected"/>
                <field name="organizer_amount" optional="show"/>
                <field name="payout_state" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="ocd_vote_contest_view_form" model="ir.ui.view">
        <field name="name">ocd.vote.contest.form</field>
        <field name="model">ocd.vote.contest</field>
        <field name="arch" type="xml">
            <form string="Contest">
                <header>
                    <button name="action_ocd_send_to_check" type="object" string="Send to check" invisible="state != 'draft'"/>
                    <button name="action_ocd_approve" type="object" string="Check and open" class="btn-primary"
                            invisible="state not in ('draft', 'to_check')"/>
                    <button name="action_ocd_close" type="object" string="Close now" invisible="state != 'approved'"
                            confirm="No vote after this. Close the votes now?"/>
                    <button name="action_ocd_publish_results" type="object" string="Publish the certified results"
                            class="btn-primary" invisible="state != 'closed'"/>
                    <button name="action_ocd_print_results" type="object" string="Certified results" invisible="state != 'done'"/>
                    <button name="action_ocd_payout_paid" type="object" string="Payout paid" class="btn-primary"
                            invisible="payout_state != 'to_pay'"/>
                    <button name="action_ocd_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"
                            confirm="Cancel this contest?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_check,approved,closed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ocd_view_votes" type="object" class="oe_stat_button" icon="how_to_vote">
                            <field name="vote_count" widget="statinfo" string="Votes"/>
                        </button>
                        <button name="action_ocd_open_page" type="object" class="oe_stat_button" icon="public" string="Page"/>
                        <button name="action_ocd_open_band" type="object" class="oe_stat_button" icon="live_tv" string="Band"/>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Miss Douala 2026"/></h1>
                    </div>
                    <group>
                        <group string="The contest">
                            <field name="organizer_id" context="{'default_ocd_vote_organizer': True}"/>
                            <field name="organizer_verified" invisible="not organizer_id"/>
                            <field name="slug"/>
                            <field name="country_id"/>
                            <field name="city"/>
                            <field name="date_open"/>
                            <field name="date_close"/>
                            <field name="final_at"/>
                            <field name="final_url" widget="url"/>
                        </group>
                        <group string="Prices">
                            <field name="vote_price"/>
                            <field name="organizer_share"/>
                            <field name="hide_hours"/>
                            <field name="currency_id" invisible="True"/>
                            <field name="pack_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="votes"/>
                                    <field name="price"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <notebook>
                        <page string="Candidates" name="candidates">
                            <field name="candidate_ids">
                                <list editable="bottom" decoration-muted="state == 'refused'" decoration-warning="state == 'to_check' or has_pending">
                                    <field name="number" readonly="1"/>
                                    <field name="name"/>
                                    <field name="city"/>
                                    <field name="bio"/>
                                    <field name="photo" widget="image" options="{'size': [40, 40]}"/>
                                    <field name="state"/>
                                    <field name="has_pending" column_invisible="True"/>
                                    <field name="vote_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Texts" name="texts">
                            <group>
                                <field name="description"/>
                                <field name="prize"/>
                                <field name="rules"/>
                            </group>
                        </page>
                        <page string="Money" name="money">
                            <group>
                                <group>
                                    <field name="amount_total"/>
                                    <field name="organizer_amount"/>
                                    <field name="payment_count"/>
                                    <field name="voter_count"/>
                                </group>
                                <group>
                                    <field name="payout_state"/>
                                    <field name="payout_due"/>
                                    <field name="payout_momo"/>
                                    <field name="payout_reference"/>
                                    <field name="payout_date"/>
                                    <field name="results_at"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ocd_vote_contest_view_search" model="ir.ui.view">
        <field name="name">ocd.vote.contest.search</field>
        <field name="model">ocd.vote.contest</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="organizer_id"/>
                <filter name="to_check" string="To check" domain="[('state', '=', 'to_check')]"/>
                <filter name="open" string="Checked" domain="[('state', '=', 'approved')]"/>
                <filter name="to_pay" string="Payout to pay" domain="[('payout_state', '=', 'to_pay')]"/>
            </search>
        </field>
    </record>

    <record id="ocd_vote_contest_action" model="ir.actions.act_window">
        <field name="name">Contests</field>
        <field name="res_model">ocd.vote.contest</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>The contests of OCD Vote: an organiser (or OCD Live) adds the candidates, the team checks the contest and opens it. Only the paid votes count.</p>
        </field>
    </record>

    <!-- The organisers: on the form of a contact, and the button of their contests -->
    <record id="res_partner_view_form_ocd_vote" model="ir.ui.view">
        <field name="name">res.partner.view.form.ocd.vote</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ocd_view_contests" type="object" class="oe_stat_button" icon="how_to_vote"
                        invisible="not ocd_vote_organizer" string="Contests" groups="ocd_live.group_ocd_live_user"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="OCD Vote" name="ocd_vote" groups="ocd_live.group_ocd_live_user">
                    <group>
                        <field name="ocd_vote_organizer"/>
                        <field name="ocd_vote_organizer_verified" invisible="not ocd_vote_organizer"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_partner_action_ocd_vote_organizer" model="ir.actions.act_window">
        <field name="name">Organisers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ocd_vote_organizer', '=', True)]</field>
        <field name="context">{'default_ocd_vote_organizer': True}</field>
    </record>

</odoo>
