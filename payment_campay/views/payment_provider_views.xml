<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Campay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'campay'" colspan="2">
                    <field string="App Username" name="campay_app_username" required="code == 'campay' and is_live"/>
                    <field string="App Password" name="campay_app_password" required="code == 'campay' and is_live" widget="password"/>
                    <field string="Webhook Key" name="campay_webhook_key" required="code == 'campay' and is_live" widget="password"/>
                    <div class="text-muted" colspan="2">
                        In the Campay dashboard, set the webhook URL to
                        <code>https://your-domain/payment/campay/webhook</code>.
                        Without live mode, payments go through the Campay demo platform.
                    </div>
                </group>
                <group invisible="code != 'campay'" colspan="2" string="Demo payments">
                    <field name="campay_demo_active"/>
                    <field name="campay_demo_amount" invisible="not campay_demo_active"/>
                    <field name="campay_demo_end" invisible="not campay_demo_active"/>
                    <field name="campay_demo_numbers" invisible="not campay_demo_active"
                           placeholder="Empty: every payment. Else e.g. 670000001, 690000002"/>
                    <div class="text-muted" colspan="2">
                        For a presentation or a test with real phones: every payment collects this amount instead of
                        the amount of the order. The pages show the real amounts, the order is paid as usual and the
                        accounts record the money received. Off by itself after the last day.
                    </div>
                </group>
            </group>
        </field>
    </record>

</odoo>
