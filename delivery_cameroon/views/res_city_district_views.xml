<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_city_district_view_list" model="ir.ui.view">
        <field name="name">res.city.district.list</field>
        <field name="model">res.city.district</field>
        <field name="arch" type="xml">
            <list string="Districts" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="city_id" options="{'no_create': True}"/>
                <field name="state_id" optional="show"/>
                <field name="country_id" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="res_city_district_view_search" model="ir.ui.view">
        <field name="name">res.city.district.search</field>
        <field name="model">res.city.district</field>
        <field name="arch" type="xml">
            <search string="Districts">
                <field name="name"/>
                <field name="city_id"/>
                <field name="state_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="group_by_city" string="City" context="{'group_by': 'city_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_res_city_district" model="ir.actions.act_window">
        <field name="name">Districts</field>
        <field name="res_model">res.city.district</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_by_city': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the districts (quartiers) of a city</p>
            <p>Customers pick their district at checkout, and delivery methods can be limited to
                some districts. Use Import records to load many districts at once.</p>
        </field>
    </record>

    <record id="action_res_city_cameroon" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">res.city</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('country_id.code', '=', 'CM')]</field>
        <!-- eval: the id of Cameroon is written in the context, the web client cannot call ref() -->
        <field name="context" eval="{'default_country_id': ref('base.cm')}"/>
    </record>

    <menuitem id="menu_cameroon_addresses"
              name="Cities and Districts"
              parent="website_sale.menu_ecommerce_settings"
              sequence="95">
        <menuitem id="menu_res_city_cameroon" action="action_res_city_cameroon" sequence="10"/>
        <menuitem id="menu_res_city_district" action="action_res_city_district" sequence="20"/>
    </menuitem>

</odoo>
