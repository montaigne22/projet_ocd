<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_district" model="ir.ui.view">
        <field name="name">res.partner.form.district</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_address_extended.address_street_extended_city_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_address_format')]/field[@name='street2']" position="after">
                <field name="district_id"
                       placeholder="District"
                       class="o_address_street"
                       invisible="not country_enforce_cities"
                       options="{'no_create': True}"/>
                <field name="delivery_landmark"
                       placeholder="Landmark, e.g. opposite the pharmacy"
                       class="o_address_street"
                       invisible="not country_enforce_cities"/>
            </xpath>
        </field>
    </record>

</odoo>
