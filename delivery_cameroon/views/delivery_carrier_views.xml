<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_carrier_form_cameroon" model="ir.ui.view">
        <field name="name">delivery.carrier.form.cameroon</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <field name="zip_prefix_ids" position="after">
                <field name="city_ids"
                       widget="many2many_tags"
                       domain="[('country_id', 'in', country_ids)] if country_ids else []"
                       options="{'no_create': True}"/>
                <field name="district_ids"
                       widget="many2many_tags"
                       domain="[('city_id', 'in', city_ids)] if city_ids else []"
                       options="{'no_create': True}"/>
                <field name="excluded_city_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"/>
                <field name="excluded_country_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="view_delivery_carrier_tree_cameroon" model="ir.ui.view">
        <field name="name">delivery.carrier.list.cameroon</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_tree"/>
        <field name="arch" type="xml">
            <field name="country_ids" position="after">
                <field name="city_ids" widget="many2many_tags" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
