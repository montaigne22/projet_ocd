<?xml version="1.0" encoding="utf-8"?>
<!-- The six categories of the validated design, with their pictogram. -->
<odoo noupdate="1">

    <record id="category_food" model="ocd.live.category">
        <field name="name">Food</field>
        <field name="icon">food</field>
        <field name="sequence">10</field>
        <field name="color">3</field>
    </record>
    <record id="category_clothes" model="ocd.live.category">
        <field name="name">Clothes</field>
        <field name="icon">clothes</field>
        <field name="sequence">20</field>
        <field name="color">2</field>
    </record>
    <record id="category_beauty" model="ocd.live.category">
        <field name="name">Beauty</field>
        <field name="icon">beauty</field>
        <field name="sequence">30</field>
        <field name="color">9</field>
    </record>
    <record id="category_phones" model="ocd.live.category">
        <field name="name">Phones</field>
        <field name="icon">phone</field>
        <field name="sequence">40</field>
        <field name="color">4</field>
    </record>
    <record id="category_home" model="ocd.live.category">
        <field name="name">Home</field>
        <field name="icon">home</field>
        <field name="sequence">50</field>
        <field name="color">10</field>
    </record>
    <record id="category_other" model="ocd.live.category">
        <field name="name">Other</field>
        <field name="icon">other</field>
        <field name="sequence">100</field>
        <field name="color">0</field>
    </record>

</odoo>
