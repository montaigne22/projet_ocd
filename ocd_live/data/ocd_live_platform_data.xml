<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- The platforms of the lives at the start; the team adds the others -->
    <record id="platform_tiktok" model="ocd.live.platform">
        <field name="name">TikTok</field>
        <field name="code">tiktok</field>
        <field name="domains">tiktok.com</field>
        <field name="sequence">10</field>
    </record>
    <record id="platform_facebook" model="ocd.live.platform">
        <field name="name">Facebook</field>
        <field name="code">facebook</field>
        <field name="domains">facebook.com, fb.watch, fb.com</field>
        <field name="sequence">20</field>
    </record>
    <record id="platform_instagram" model="ocd.live.platform">
        <field name="name">Instagram</field>
        <field name="code">instagram</field>
        <field name="domains">instagram.com</field>
        <field name="sequence">30</field>
    </record>
    <record id="platform_youtube" model="ocd.live.platform">
        <field name="name">YouTube</field>
        <field name="code">youtube</field>
        <field name="domains">youtube.com, youtu.be</field>
        <field name="sequence">40</field>
    </record>

</odoo>
