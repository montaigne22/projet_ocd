<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_release_expired_holds" model="ir.cron">
        <field name="name">OCD Live: release the slots that were not paid</field>
        <field name="model_id" ref="model_ocd_live_booking"/>
        <field name="state">code</field>
        <field name="code">model._cron_release_expired_holds()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_mark_done" model="ir.cron">
        <field name="name">OCD Live: mark the past lives as done</field>
        <field name="model_id" ref="model_ocd_live_booking"/>
        <field name="state">code</field>
        <field name="code">model._cron_mark_done()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

    <record id="ir_cron_check_hosts" model="ir.cron">
        <field name="name">OCD Live: remind the remote lives without host</field>
        <field name="model_id" ref="model_ocd_live_booking"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_hosts()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

    <record id="ir_cron_expire_credits" model="ir.cron">
        <field name="name">OCD Live: expire the old live credits</field>
        <field name="model_id" ref="model_ocd_live_credit"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_update_listing_windows" model="ir.cron">
        <field name="name">OCD Live: open and close the directory windows</field>
        <field name="model_id" ref="model_ocd_directory_listing"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_windows()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_update_pass_states" model="ir.cron">
        <field name="name">OCD Live: start and end the directory passes</field>
        <field name="model_id" ref="model_ocd_directory_pass"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_states()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

    <record id="ir_cron_pass_reminders" model="ir.cron">
        <field name="name">OCD Live: remind the passes that end soon</field>
        <field name="model_id" ref="model_ocd_directory_pass"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

</odoo>
