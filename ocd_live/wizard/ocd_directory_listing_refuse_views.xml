<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ocd_directory_listing_refuse_view_form" model="ir.ui.view">
        <field name="name">ocd.directory.listing.refuse.view.form</field>
        <field name="model">ocd.directory.listing.refuse</field>
        <field name="arch" type="xml">
            <form string="Refuse the link">
                <group>
                    <field name="listing_ids" widget="many2many_tags" invisible="1"/>
                    <field name="reason_id" options="{'no_create': True}"/>
                    <field name="note" placeholder="Optional: a sentence for the vendor"/>
                </group>
                <footer>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
