<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ocd_live.Tools">
        <div class="o_action o_ocd_bo o_ocd_tools">
            <t t-set="data" t-value="this.data()"/>
            <div class="o_ocd_bo_header">
                <h1 class="o_ocd_bo_title">Odoo tools used</h1>
                <span class="o_ocd_bo_pager o_ocd_bo_push" t-out="data.edition"/>
            </div>
            <div class="o_ocd_bo_body o_ocd_tools_body">
                <div class="o_ocd_tools_filters">
                    <span>Show what is used for:</span>
                    <div class="o_ocd_orders_filters" role="group" aria-label="Filter by area">
                        <button t-foreach="data.areas" t-as="area" t-key="area.key" type="button"
                                t-att-aria-pressed="this.area() === area.key ? 'true' : 'false'"
                                t-on-click="() => this.area.set(area.key)" t-out="area.label"/>
                    </div>
                    <span class="o_ocd_tools_note">No paid application of Odoo is needed.</span>
                </div>
                <div class="o_ocd_tools_columns">
                    <section class="o_ocd_tools_card">
                        <b>Standard applications of Odoo</b>
                        <div t-foreach="data.apps" t-as="row" t-key="row.key" t-att-class="{ 'o_ocd_tools_row': true, 'o_ocd_faded': this.faded(row) }">
                            <b t-out="row.name"/>
                            <span t-out="row.use"/>
                            <span t-attf-class="o_ocd_tools_state #{row.installed ? 'o_ocd_on' : ''}">
                                <t t-if="row.installed">Installed</t><t t-else="">Not installed</t>
                            </span>
                        </div>
                    </section>
                    <div class="o_ocd_tools_stack">
                        <section class="o_ocd_tools_card">
                            <b>Modules of the repository</b>
                            <div t-foreach="data.repository" t-as="row" t-key="row.key" t-att-class="{ 'o_ocd_tools_module': true, 'o_ocd_faded': this.faded(row) }">
                                <span class="o_ocd_tools_module_head">
                                    <code t-out="row.name"/>
                                    <span t-attf-class="o_ocd_tools_state #{row.installed ? 'o_ocd_on' : ''}">
                                        <t t-if="row.installed">Installed</t><t t-else="">Not installed</t>
                                    </span>
                                </span>
                                <span t-out="row.use"/>
                                <small t-if="row.limit" t-out="row.limit"/>
                            </div>
                        </section>
                        <section class="o_ocd_tools_card">
                            <b>Paid applications: not needed</b>
                            <div t-foreach="data.not_needed" t-as="row" t-key="row.key" t-att-class="{ 'o_ocd_tools_row o_ocd_tools_row_two': true, 'o_ocd_faded': this.faded(row) }">
                                <span t-out="row.name"/>
                                <span t-out="row.use"/>
                            </div>
                        </section>
                    </div>
                    <section class="o_ocd_tools_card o_ocd_tools_dark">
                        <b>Modules of OCD Live</b>
                        <div t-foreach="data.ocd" t-as="row" t-key="row.key" class="o_ocd_tools_ocd">
                            <span class="o_ocd_tools_bullet" aria-hidden="true"/>
                            <span>
                                <code t-out="row.name"/>
                                <span t-out="row.use"/>
                            </span>
                            <span t-attf-class="o_ocd_tools_state #{row.installed ? 'o_ocd_on' : ''}">
                                <t t-if="row.installed">Installed</t><t t-else="">Not installed</t>
                            </span>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </t>

</templates>
