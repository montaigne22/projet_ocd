<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ocd_live_category_view_list" model="ir.ui.view">
        <field name="name">ocd.live.category.view.list</field>
        <field name="model">ocd.live.category</field>
        <field name="arch" type="xml">
            <list string="Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="color" widget="color_picker"/>
                <field name="vendor_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ocd_live_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">ocd.live.category</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
