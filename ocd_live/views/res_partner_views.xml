<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.ocd.live</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_ocd_view_bookings" type="object" class="oe_stat_button" icon="videocam"
                        invisible="not ocd_is_vendor" groups="ocd_live.group_ocd_live_user">
                    <field name="ocd_booking_count" widget="statinfo" string="Lives"/>
                </button>
                <button name="action_ocd_view_credits" type="object" class="oe_stat_button" icon="confirmation_number"
                        invisible="not ocd_is_vendor" groups="ocd_live.group_ocd_live_user">
                    <field name="ocd_lives_remaining" widget="statinfo" string="To place"/>
                </button>
            </div>
            <notebook position="inside">
                <page name="ocd_live" string="OCD Live" groups="ocd_live.group_ocd_live_user">
                    <group>
                        <group string="Vendor">
                            <field name="ocd_is_vendor"/>
                            <field name="ocd_business" invisible="not ocd_is_vendor"/>
                            <field name="ocd_category_id" invisible="not ocd_is_vendor" options="{'no_create': True}"/>
                            <field name="ocd_vendor_state" invisible="not ocd_is_vendor"/>
                        </group>
                        <group string="Directory" invisible="not ocd_is_vendor">
                            <field name="ocd_pass_active"/>
                            <field name="ocd_pass_end_date"/>
                            <button name="action_ocd_view_space" type="object" string="See the space"
                                    class="btn-link ps-0" colspan="2" groups="ocd_live.group_ocd_live_user"/>
                            <button name="action_ocd_reset_space_link" type="object" string="New personal link"
                                    class="btn-link ps-0" colspan="2"
                                    confirm="The vendor will need the new link: the old one stops working, and so do the phones where it was opened."/>
                            <button name="action_ocd_create_password_access" type="object" string="Access with a password"
                                    class="btn-link ps-0" colspan="2" groups="ocd_live.group_ocd_live_manager"/>
                        </group>
                    </group>
                    <div class="d-flex gap-2" invisible="not ocd_is_vendor or ocd_vendor_state != 'to_check'">
                        <button name="action_ocd_approve_vendor" type="object" string="Approve the vendor" class="btn-primary"/>
                        <button name="action_ocd_refuse_vendor" type="object" string="Refuse"/>
                    </div>
                </page>
            </notebook>
        </field>
    </record>

    <record id="res_partner_view_search_ocd_vendor" model="ir.ui.view">
        <field name="name">res.partner.view.search.ocd.vendor</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="ocd_business"/>
                <field name="ocd_category_id"/>
                <filter string="To check" name="ocd_to_check" domain="[('ocd_vendor_state', '=', 'to_check')]"/>
                <filter string="Approved" name="ocd_approved" domain="[('ocd_vendor_state', '=', 'approved')]"/>
                <separator/>
            </field>
        </field>
    </record>

    <record id="res_partner_view_list_ocd_vendor" model="ir.ui.view">
        <field name="name">res.partner.view.list.ocd.vendor</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Vendors">
                <field name="name"/>
                <field name="ocd_business"/>
                <field name="ocd_category_id"/>
                <field name="phone" optional="show"/>
                <field name="city" optional="show"/>
                <field name="country_id"/>
                <field name="ocd_lives_remaining" optional="show"/>
                <field name="ocd_pass_end_date" optional="show"/>
                <field name="ocd_vendor_state" widget="badge" decoration-success="ocd_vendor_state == 'approved'"
                       decoration-warning="ocd_vendor_state == 'to_check'" decoration-danger="ocd_vendor_state == 'refused'"/>
            </list>
        </field>
    </record>

    <!-- Record of a vendor, as in the validated design (BoVendeur) -->
    <record id="res_partner_view_form_ocd_vendor" model="ir.ui.view">
        <field name="name">res.partner.view.form.ocd.vendor</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Vendor" class="o_ocd_vendor_form">
                <header>
                    <button name="action_ocd_approve_vendor" type="object" string="Validate the vendor" class="btn-primary"
                            invisible="ocd_vendor_state != 'to_check'"/>
                    <button name="action_ocd_refuse_vendor" type="object" string="Refuse"
                            invisible="ocd_vendor_state != 'to_check'"/>
                    <button name="action_ocd_open_whatsapp" type="object" string="Write on WhatsApp" invisible="not phone"/>
                    <button name="action_ocd_view_space" type="object" string="See the space" groups="ocd_live.group_ocd_live_user"/>
                    <field name="ocd_vendor_state" widget="statusbar" statusbar_visible="to_check,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ocd_view_bookings" type="object" class="oe_stat_button" icon="videocam">
                            <field name="ocd_booking_count" widget="statinfo" string="Lives"/>
                        </button>
                        <button name="action_ocd_view_credits" type="object" class="oe_stat_button" icon="confirmation_number">
                            <field name="ocd_lives_remaining" widget="statinfo" string="To place"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title o_ocd_vendor_title">
                        <h1><field name="name" placeholder="Name of the vendor" required="1"/></h1>
                        <div class="o_ocd_vendor_line">
                            <field name="ocd_business" placeholder="What the vendor sells" class="o_ocd_inline"/>
                        </div>
                    </div>
                    <field name="ocd_is_vendor" invisible="1"/>
                    <field name="is_company" invisible="1"/>
                    <notebook>
                        <page name="ocd_sale" string="Sale and delivery">
                            <group name="ocd_vendor_main">
                                <group>
                                    <field name="ocd_category_id" options="{'no_create': True}"/>
                                    <field name="country_id" options="{'no_create': True}"/>
                                </group>
                                <group>
                                    <field name="city"/>
                                </group>
                            </group>
                        </page>
                        <page name="ocd_quality" string="Quality">
                            <div class="o_ocd_kpis" name="ocd_kpis">
                                <div class="o_ocd_kpi">
                                    <span>Lives booked</span>
                                    <field name="ocd_booking_count"/>
                                </div>
                                <div class="o_ocd_kpi">
                                    <span>Lives to place</span>
                                    <field name="ocd_lives_remaining"/>
                                </div>
                            </div>
                        </page>
                        <page name="ocd_contact" string="Contact details">
                            <group>
                                <group>
                                    <field name="phone" widget="phone" string="WhatsApp"/>
                                    <field name="email" widget="email"/>
                                    <field name="ocd_live_handle" placeholder="@name on TikTok"/>
                                    <field name="ocd_whatsapp_optin"/>
                                </group>
                                <group>
                                    <field name="street" string="Address"/>
                                    <field name="create_date" string="Vendor since" readonly="1"/>
                                    <field name="ocd_vendor_checked_at" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page name="ocd_directory" string="Directory and space">
                            <group>
                                <group>
                                    <field name="ocd_pass_active"/>
                                    <field name="ocd_pass_end_date"/>
                                </group>
                                <group>
                                    <button name="action_ocd_reset_space_link" type="object" string="New personal link"
                                            class="btn-link ps-0" colspan="2"
                                            confirm="The vendor will need the new link: the old one stops working, and so do the phones where it was opened."/>
                                    <button name="action_ocd_create_password_access" type="object" string="Access with a password"
                                            class="btn-link ps-0" colspan="2" groups="ocd_live.group_ocd_live_manager"/>
                                </group>
                            </group>
                        </page>
                        <page name="ocd_card" string="Card in the lives">
                            <group>
                                <group>
                                    <field name="ocd_card_media" widget="radio"/>
                                    <field name="ocd_card_video" filename="ocd_card_video_name"/>
                                    <field name="ocd_card_video_name" invisible="1"/>
                                    <field name="ocd_card_video_pending" invisible="not ocd_card_video_pending"/>
                                    <field name="ocd_card_video_error" invisible="not ocd_card_video_error"
                                           decoration-danger="1"/>
                                    <field name="ocd_card_video_sound" invisible="not ocd_card_video"/>
                                    <field name="ocd_card_image" widget="image" options="{'size': [180, 225]}"/>
                                </group>
                                <group>
                                    <field name="ocd_card_video_poster" widget="image" readonly="1"
                                           invisible="not ocd_card_video" options="{'size': [135, 240]}"/>
                                    <div class="text-muted" colspan="2">
                                        The card of the vendor in the feed of the lives shows its short video, its
                                        products or its image. The vendor chooses it in its space; a video of 30
                                        seconds at most, filmed upright, plays without sound when the card is on screen.
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="res_partner_action_ocd_vendor" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('ocd_is_vendor', '=', True)]</field>
        <field name="context">{'default_ocd_is_vendor': True, 'default_is_company': True}</field>
        <field name="search_view_id" ref="res_partner_view_search_ocd_vendor"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('res_partner_view_list_ocd_vendor')}),
            Command.create({'view_mode': 'kanban'}),
            Command.create({'view_mode': 'form', 'view_id': ref('res_partner_view_form_ocd_vendor')})]"/>
    </record>

</odoo>
