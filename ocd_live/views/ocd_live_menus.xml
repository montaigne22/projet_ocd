    <menuitem id="ocd_live_category_menu" name="Categories" parent="ocd_live_menu_config"
              action="ocd_live_category_action" sequence="30"/>
    <menuitem id="ocd_live_country_menu" name="Countries" parent="ocd_live_menu_config"
              action="ocd_country_action" sequence="35"/>
    <menuitem id="ocd_directory_window_menu" name="Checking windows" parent="ocd_live_menu_config"
              action="ocd_directory_window_action" sequence="40"/>
    <menuitem id="ocd_live_platform_menu" name="Live platforms" parent="ocd_live_menu_config"
              action="ocd_live_platform_action" sequence="42"/>
    <menuitem id="ocd_live_account_menu" name="Live accounts" parent="ocd_live_menu_config"
              action="ocd_live_account_action" sequence="43"/>
    <menuitem id="ocd_listing_refuse_reason_menu" name="Refusal reasons" parent="ocd_live_menu_config"
              action="ocd_listing_refuse_reason_action" sequence="50"/>
    <menuitem id="ocd_voice_prompt_menu" name="Voices of the pages" parent="ocd_live_menu_config"
