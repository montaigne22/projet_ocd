<?xml version="1.0" encoding="utf-8"?>
<!-- Menus of OCD Live, as in the validated design (BoShell): the sections are the links of the
     dark bar (Dashboard, Lives, Shop, Deliveries, Vendors, WhatsApp, Recruitment,
     Configuration), their menus are the tabs below it. The other modules add their sections. -->
<odoo>

    <menuitem id="ocd_live_menu_root" name="OCD Live" sequence="25"
              web_icon="ocd_live,static/description/icon.png"
              action="ocd_live_dashboard_action"
              groups="ocd_live.group_ocd_live_user"/>
    <menuitem id="ocd_live_menu_dashboard" name="Dashboard" parent="ocd_live_menu_root" sequence="1"/>
    <menuitem id="ocd_live_dashboard_menu" name="Overview" parent="ocd_live_menu_dashboard"
              action="ocd_live_dashboard_action" sequence="10"/>

    <menuitem id="ocd_live_menu_lives" name="Lives" parent="ocd_live_menu_root" sequence="10"/>
    <menuitem id="ocd_live_booking_menu" name="Bookings" parent="ocd_live_menu_lives"
              action="ocd_live_planning_action" sequence="10"/>
    <menuitem id="ocd_directory_listing_menu" name="To check" parent="ocd_live_menu_lives"
              action="ocd_live_verification_action" sequence="30"/>
    <menuitem id="ocd_live_credit_menu" name="Lives to place" parent="ocd_live_menu_lives"
              action="ocd_live_credit_action" sequence="40"/>
    <menuitem id="ocd_live_host_menu" name="Hosts" parent="ocd_live_menu_lives"
              action="hr_employee_action_ocd_host" sequence="50"/>

    <menuitem id="ocd_live_menu_vendors" name="Vendors" parent="ocd_live_menu_root" sequence="40"/>
    <menuitem id="ocd_live_vendor_menu" name="Vendors" parent="ocd_live_menu_vendors"
              action="res_partner_action_ocd_vendor" sequence="10"/>
    <menuitem id="ocd_directory_pass_menu" name="Directory passes" parent="ocd_live_menu_vendors"
              action="ocd_directory_pass_action" sequence="30"/>

    <menuitem id="ocd_live_menu_config" name="Configuration" parent="ocd_live_menu_root" sequence="90"
              groups="ocd_live.group_ocd_live_manager"/>
    <menuitem id="ocd_live_settings_menu" name="Settings" parent="ocd_live_menu_config"
              action="ocd_live_settings_action" sequence="10"/>
    <menuitem id="ocd_live_package_menu" name="Packages and pass" parent="ocd_live_menu_config"
              action="product_template_action_ocd_package" sequence="20"/>
    <menuitem id="ocd_live_price_rule_menu" name="Price of the hours" parent="ocd_live_menu_config"
