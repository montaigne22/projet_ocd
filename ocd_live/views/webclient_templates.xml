<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The fonts of the design in the back office -->
    <template id="webclient_bootstrap_fonts" inherit_id="web.webclient_bootstrap" name="OCD Live: fonts of the back office">
        <xpath expr="//t[@t-set='head']" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&amp;family=Figtree:wght@400;500;600;700;800&amp;display=swap"/>
        </xpath>
    </template>

</odoo>
