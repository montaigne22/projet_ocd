<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ocd_listing_refuse_reason_view_list" model="ir.ui.view">
        <field name="name">ocd.listing.refuse.reason.view.list</field>
        <field name="model">ocd.listing.refuse.reason</field>
        <field name="arch" type="xml">
            <list string="Refusal reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="message"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ocd_listing_refuse_reason_action" model="ir.actions.act_window">
        <field name="name">Refusal reasons</field>
        <field name="res_model">ocd.listing.refuse.reason</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
