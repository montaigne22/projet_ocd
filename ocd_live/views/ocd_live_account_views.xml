<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ocd_live_account_view_list" model="ir.ui.view">
        <field name="name">ocd.live.account.list</field>
        <field name="model">ocd.live.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="platform_id"/>
                <field name="handle"/>
                <field name="mode"/>
                <field name="country_ids" widget="many2many_tags" optional="show"/>
                <field name="booking_count" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ocd_live_account_view_form" model="ir.ui.view">
        <field name="name">ocd.live.account.form</field>
        <field name="model">ocd.live.account</field>
        <field name="arch" type="xml">
            <form string="Live account">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ocd_view_bookings" type="object" class="oe_stat_button" icon="videocam">
                            <field name="booking_count" widget="statinfo" string="Next lives"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. OCD Live Togo"/></h1>
                    </div>
                    <group>
                        <group string="On the platform">
                            <field name="platform_id" options="{'no_create': True}"/>
                            <field name="handle" placeholder="@ocdlive.tg"/>
                            <field name="live_url" widget="url" placeholder="https://www.tiktok.com/@ocdlive.tg/live"/>
                        </group>
                        <group string="Its lives">
                            <field name="mode" widget="radio"/>
                            <field name="country_ids" widget="many2many_tags" options="{'no_create': True}"
                                   placeholder="All the countries"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="For the team, e.g. who holds the phone of the account"/>
                    <div class="text-muted mt-3">
                        Each live takes the first account that fits its mode and the country of its vendor
                        (the accounts of its country first), free at its hour; the team can change it on the live.
                        The vendor of a remote live joins this account as a guest: 15 minutes before, they receive
                        the page « Join my live » with its name and its link.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ocd_live_account_action" model="ir.actions.act_window">
        <field name="name">Live accounts</field>
        <field name="res_model">ocd.live.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an account of OCD Live where the lives go</p>
            <p>The lives at the studio go on it, and the vendors of the remote lives join it as guests.
                Set one per country, or one for the studio and one for the remote lives.</p>
        </field>
    </record>

</odoo>
