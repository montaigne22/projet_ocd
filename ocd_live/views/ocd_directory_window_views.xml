<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ocd_directory_window_view_list" model="ir.ui.view">
        <field name="name">ocd.directory.window.view.list</field>
        <field name="model">ocd.directory.window</field>
        <field name="arch" type="xml">
            <list string="Checking windows" editable="bottom">
                <field name="name"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ocd_directory_window_action" model="ir.actions.act_window">
        <field name="name">Checking windows</field>
        <field name="res_model">ocd.directory.window</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
