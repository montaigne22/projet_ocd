<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================== -->
    <!-- Space of the vendor: log in, then the next lives, the lives    -->
    <!-- to place, the directory pass and the WhatsApp messages.        -->
    <!-- ============================================================== -->

    <template id="space_team" name="OCD Live: the team in the space of the vendors">
        <!-- Title of the tab of the browser -->
        <t t-set="additional_title">Space of the vendors</t>
        <t t-call="ocd_live.app">
            <div class="o_ocd_frame o_ocd_narrow o_ocd_team_notice">
                <main class="o_ocd_main">
                    <h1 class="o_ocd_h1">You are logged in as the team.</h1>
                    <p class="o_ocd_intro"><span>Account of</span> <b t-out="team_name"/></p>
                    <p class="o_ocd_intro">The space is for the vendors: their lives, their packages, their pass. It opens with the WhatsApp number of the vendor, not with an account of the team.</p>
                    <div class="o_ocd_info">To see what a vendor sees: open the vendor in the back office, then « See the space ».</div>
                    <div class="o_ocd_info">A number typed with an account of the team sends nothing.</div>
                </main>
                <div class="o_ocd_actions">
                    <a t-att-href="back_office_url" class="o_ocd_cta" t-out="back_office_label"/>
                    <a href="/ocd" class="o_ocd_cta o_ocd_cta_ghost">Back to the home page</a>
                </div>
            </div>
        </t>
    </template>

    <template id="space_account" name="OCD Live: an account that is not a vendor">
        <!-- Title of the tab of the browser -->
        <t t-set="additional_title">My account</t>
        <t t-call="ocd_live.app">
            <div class="o_ocd_frame o_ocd_narrow o_ocd_account_notice">
                <main class="o_ocd_main">
                    <h1 class="o_ocd_h1">This account is not a vendor account.</h1>
                    <p class="o_ocd_intro"><span>Account of</span> <b t-out="account_name"/></p>
                    <p class="o_ocd_intro">To reach your space, log in with the number and the password of your vendor account.</p>
                </main>
                <div class="o_ocd_actions">
                    <form action="/web/session/logout" method="post" class="o_ocd_inline_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="redirect" t-att-value="logout_redirect"/>
                        <button type="submit" class="o_ocd_cta">Log in with another account</button>
                    </form>
                    <a href="/ocd" class="o_ocd_cta o_ocd_cta_ghost">Back to the home page</a>
                </div>
            </div>
        </t>
    </template>

    <template id="space_login" name="OCD Live: find my space">
        <!-- Title of the tab of the browser -->
        <t t-set="additional_title">Find my space</t>
        <t t-call="ocd_live.app">
            <form t-att-action="form_action or '/ocd/connexion'" method="post" class="o_ocd_frame o_ocd_narrow" novalidate="novalidate">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <main class="o_ocd_main">
                    <h1 t-if="target == 'livrer'" class="o_ocd_h1">Your parcels to deliver.</h1>
                    <h1 t-else="" class="o_ocd_h1">Find your space.</h1>
                    <p class="o_ocd_intro">
                        <t t-if="login == 'whatsapp_code'">No password. We send you a code on WhatsApp.</t>
                        <t t-else="">No password. We send you a link on WhatsApp.</t>
                    </p>
                    <div t-if="account_name" class="o_ocd_info o_ocd_account_info">
                        <p class="mb-1"><span>Logged in as</span> <b t-out="account_name"/></p>
                        <p class="mb-0">This account is not linked to a vendor yet: give the WhatsApp number of your space of vendor.</p>
                    </div>
                    <div class="o_ocd_field o_ocd_field_big">
                        <label for="c-phone" class="o_ocd_label">Your WhatsApp number</label>
                        <t t-call="ocd_live.phone_field" field_id.f="c-phone"/>
                        <span t-if="error" class="o_ocd_error" role="alert" t-out="error"/>
                    </div>
                    <div t-if="sent" class="o_ocd_ok o_ocd_ok_big" role="status">
                        <b>Look at your WhatsApp.</b>
                        <span t-if="target == 'livrer'">Touch the link you received: your parcels open by themselves. This link works only for you.</span>
                        <span t-else="">Touch the link you received: your space opens by itself. This link works only for you.</span>
                    </div>
                    <div t-elif="target == 'livrer'" class="o_ocd_info">For the couriers of OCD Live and the vendors who deliver: give the number you gave to OCD Live.</div>
                    <div t-else="" class="o_ocd_info">
                        Your ticket and your reminders already come with this link. Keep this message in WhatsApp to come back whenever you want.
                    </div>
                    <a t-if="target == 'livrer' and password_url" t-att-href="password_url" class="o_ocd_info d-block">A vendor with a password? Log in</a>
                </main>
                <div class="o_ocd_actions">
                    <button t-if="sent" type="submit" class="o_ocd_cta o_ocd_cta_ghost">I received nothing: send again</button>
                    <button t-else="" type="submit" class="o_ocd_cta">
                        <t t-if="login == 'whatsapp_code'">Receive my code</t>
                        <t t-else="">Receive my link</t>
                    </button>
                </div>
            </form>
        </t>
    </template>

    <template id="space_login_code" name="OCD Live: code received on WhatsApp">
        <!-- Title of the tab of the browser -->
        <t t-set="additional_title">Code received on WhatsApp</t>
        <t t-call="ocd_live.app">
            <form t-att-action="code_action or '/ocd/connexion/code'" method="post" class="o_ocd_frame o_ocd_narrow">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <main class="o_ocd_main">
                    <h1 class="o_ocd_h1">Type the code.</h1>
                    <p class="o_ocd_intro">If your number is known, a code of 6 digits arrives on your WhatsApp.</p>
                    <div class="o_ocd_field o_ocd_field_big">
                        <label for="c-code" class="o_ocd_label">Code</label>
                        <input id="c-code" name="code" class="o_ocd_input o_ocd_code" inputmode="numeric"
                               autocomplete="one-time-code" maxlength="6" required="required"/>
                        <span t-if="error" class="o_ocd_error" role="alert" t-out="error"/>
                    </div>
                </main>
                <div class="o_ocd_actions">
                    <button t-if="target == 'livrer'" type="submit" class="o_ocd_cta">Open my parcels</button>
                    <button t-else="" type="submit" class="o_ocd_cta">Open my space</button>
                    <a t-att-href="form_action or '/ocd/connexion'" class="o_ocd_cta o_ocd_cta_ghost">Ask for a new code</a>
                </div>
            </form>
        </t>
    </template>

    <template id="space_card" name="OCD Live: my card in the lives">
        <!-- Title of the tab of the browser -->
        <t t-set="additional_title">My card in the lives</t>
        <t t-call="ocd_live.app">
            <div class="o_ocd_frame o_ocd_narrow">
                <main class="o_ocd_main o_ocd_space o_ocd_card_page">
                    <h1 class="o_ocd_h1 o_ocd_h1_small">How people see you</h1>
                    <p class="o_ocd_lead">Your card in the feed of the lives: while you are live, before your next live and in your replays.</p>
                    <div t-if="saved" class="o_ocd_ok o_ocd_info_icon" role="status">
                        <t t-call="ocd_live.icon" icon.f="check"/>
                        <span>Saved: your card is up to date in the feed.</span>
                    </div>
                    <div t-if="errors" id="ma-carte-erreurs" class="o_ocd_alert" role="alert">
                        Something could not be saved: see below.
                    </div>
                    <div t-if="fallback" class="o_ocd_info" role="status" t-out="fallback"/>

                    <!-- The card as the feed shows it -->
                    <div class="o_ocd_card_preview" aria-label="Preview of your card">
                        <t t-set="cards" t-value="[preview]"/>
                        <t t-set="preview_mode" t-value="True"/>
                        <t t-call="ocd_live.feed_cards"/>
                    </div>

                    <form action="/ocd/espace/moi/carte" method="post" enctype="multipart/form-data"
                          class="o_ocd_form o_ocd_card_form" t-att-data-max-video-mb="max_video_mb">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <fieldset class="o_ocd_fieldset">
                            <legend class="o_ocd_label">What your card shows</legend>
                            <div class="o_ocd_card_choices">
                                <t t-foreach="choices" t-as="row">
                                    <label class="o_ocd_card_choice">
                                        <input type="radio" name="choice" t-att-value="row['value']"
                                               t-att-checked="row['value'] == chosen or None"/>
                                        <span class="o_ocd_card_choice_box">
                                            <span class="o_ocd_card_choice_head">
                                                <b t-out="row['title']"/>
                                                <t t-if="row['value'] != 'auto'">
                                                    <span t-if="row.get('pending')" class="o_ocd_badge_wait">Being prepared</span>
                                                    <span t-elif="row['ready']" class="o_ocd_badge_ok">Available</span>
                                                    <span t-else="" class="o_ocd_badge_wait">To add</span>
                                                </t>
                                            </span>
                                            <small t-out="row['text']"/>
                                            <small t-if="not row['ready'] and row.get('missing')" class="o_ocd_card_choice_missing">
                                                <a t-if="row.get('missing_url')" t-att-href="row['missing_url']" t-out="row['missing']"/>
                                                <t t-else="" t-out="row['missing']"/>
                                            </small>
                                        </span>
                                    </label>
                                </t>
                            </div>
                        </fieldset>

                        <section class="o_ocd_card_upload" aria-labelledby="card-video-title">
                            <h2 id="card-video-title" class="o_ocd_section">My short video</h2>
                            <!-- Made readable by every phone in the background: the page updates by itself -->
                            <div t-if="video_pending" class="o_ocd_info o_ocd_poll" role="status"
                                 data-poll-url="/ocd/espace/moi/carte/etat" data-state="pending">
                                Your video is being prepared: it shows on your card in a minute. This page updates by itself.
                            </div>
                            <div t-elif="video_error" class="o_ocd_alert" role="alert">
                                Your last video could not be prepared: <t t-out="video_error"/>
                            </div>
                            <div t-if="video_url" class="o_ocd_card_current">
                                <img t-if="poster_url" t-att-src="poster_url" alt="Your video"/>
                                <video t-else="" t-att-src="video_url" playsinline="" muted="" preload="metadata" aria-hidden="true"/>
                                <label class="o_ocd_check">
                                    <input type="checkbox" name="remove_video" value="1"/>
                                    Remove my video
                                </label>
                            </div>
                            <label for="card-video" class="o_ocd_card_pick">
                                <input id="card-video" type="file" name="video" accept="video/*" class="o_ocd_card_file"
                                       data-kind="video"/>
                                <t t-call="ocd_live.icon" icon.f="camera"/>
                                <span t-if="video_url">Change my video</span>
                                <span t-else="">Choose a video</span>
                            </label>
                            <span class="o_ocd_card_file_name" aria-live="polite"/>
                            <small class="o_ocd_muted">
                                Filmed upright, your products in the middle: <t t-out="max_seconds"/> seconds at most (a longer
                                video is cut), <t t-out="max_video_mb"/> MB at most.
                            </small>
                            <span t-if="errors.get('video')" class="o_ocd_error" role="alert" t-out="errors['video']"/>
                            <span class="o_ocd_error o_ocd_card_too_big" role="alert" hidden="">
                                The video is too heavy: <t t-out="max_video_mb"/> MB at most.
                            </span>
                        </section>

                        <section class="o_ocd_card_upload" aria-labelledby="card-image-title">
                            <h2 id="card-image-title" class="o_ocd_section">My image</h2>
                            <div t-if="image_url" class="o_ocd_card_current">
                                <img t-att-src="image_url" alt="Your image"/>
                                <label class="o_ocd_check">
                                    <input type="checkbox" name="remove_image" value="1"/>
                                    Remove my image
                                </label>
                            </div>
                            <label for="card-image" class="o_ocd_card_pick">
                                <input id="card-image" type="file" name="image" accept="image/*" class="o_ocd_card_file"
                                       data-kind="image"/>
                                <t t-call="ocd_live.icon" icon.f="camera"/>
                                <span t-if="image_url">Change my image</span>
                                <span t-else="">Choose an image</span>
                            </label>
                            <span class="o_ocd_card_file_name" aria-live="polite"/>
                            <small class="o_ocd_muted">A photo upright or square, 10 MB at most. Without an image, the card shows your photo.</small>
                            <span t-if="errors.get('image')" class="o_ocd_error" role="alert" t-out="errors['image']"/>
                        </section>

                        <div class="o_ocd_actions">
                            <div class="o_ocd_card_progress" hidden="">
                                <span class="o_ocd_card_progress_bar"><i/></span>
                                <small><span>Sending</span> <b class="o_ocd_card_progress_value">0 %</b></small>
                            </div>
                            <button type="submit" class="o_ocd_cta">Save my card</button>
                            <p class="o_ocd_muted o_ocd_card_sending" role="status" hidden="">
                                Sending… Keep this page open until the end.
                            </p>
                            <p class="o_ocd_error o_ocd_card_failed" role="alert" hidden="">
                                The sending did not go through: check your connection, then try again.
                            </p>
                            <p class="o_ocd_error o_ocd_card_refused" role="alert" hidden="">
                                The server refuses a file this heavy: send a shorter video, or filmed in 1080p rather than 4K.
                            </p>
                        </div>
                    </form>
                </main>
            </div>
        </t>
    </template>

    <template id="space" name="OCD Live: my space">
        <!-- Title of the tab of the browser -->
        <t t-set="additional_title">My space</t>
        <t t-call="ocd_live.app">
            <div class="o_ocd_frame o_ocd_narrow">
                <main class="o_ocd_main o_ocd_space">
                    <h1 class="o_ocd_h1 o_ocd_h1_small" t-out="vendor.name"/>
                    <span class="o_ocd_tag o_ocd_tag_flag">
                        <span t-if="flag" t-attf-class="o_ocd_flag o_ocd_flag_#{flag}"/>
                        <t t-out="vendor_line"/>
                    </span>

                    <t t-foreach="lives" t-as="live">
                        <h2 t-if="live_first" class="o_ocd_section">My next live</h2>
                        <h2 t-if="live_index == 1" class="o_ocd_section">Then</h2>
                        <div class="o_ocd_live_card">
                            <div class="o_ocd_live_card_head">
                                <span>
                                    <b t-out="live['when']"/>
                                    <small t-out="live['line']"/>
                                </span>
                                <span t-if="live['paid']" class="o_ocd_badge_ok">Paid</span>
                                <span t-else="" class="o_ocd_badge_wait">To pay</span>
                            </div>
                            <div class="o_ocd_live_card_buttons">
                                <a t-if="live.get('join_url')" t-att-href="live['join_url']" class="o_ocd_button o_ocd_button_orange o_ocd_button_wide">
                                    Join my live
                                </a>
                                <t t-if="live['paid']">
                                    <a t-att-href="live['ticket_url']" class="o_ocd_button o_ocd_button_dark">Ticket</a>
                                    <a t-if="live['move_url']" t-att-href="live['move_url']" class="o_ocd_button o_ocd_button_line">Move</a>
                                    <a t-if="live['receipt_url']" t-att-href="live['receipt_url']" class="o_ocd_button">Receipt</a>
                                    <a t-if="live['announce_url']" t-att-href="live['announce_url']" class="o_ocd_button o_ocd_button_wide">Announce your live</a>
                                </t>
                                <a t-elif="live['pay_url']" t-att-href="live['pay_url']" class="o_ocd_button o_ocd_button_orange">Pay</a>
                            </div>
                            <small t-if="live_first and live['paid']" class="o_ocd_muted">You can move your live until <t t-out="move_limit"/> h before.</small>
                        </div>
                    </t>

                    <t t-if="credits">
                        <h2 class="o_ocd_section">Lives to place</h2>
                        <t t-foreach="credits" t-as="card">
                            <div class="o_ocd_live_card">
                                <div class="o_ocd_live_card_head">
                                    <span>
                                        <b t-out="card['name']"/>
                                        <small>
                                            <t t-out="card['line']"/>
                                            <t t-if="card['expiry']"> · <t t-out="card['expiry']"/></t>
                                        </small>
                                    </span>
                                </div>
                                <a t-att-href="card['place_url']" class="o_ocd_button o_ocd_button_orange">Place a live</a>
                            </div>
                        </t>
                    </t>

                    <h2 class="o_ocd_section">Directory of the lives</h2>
                    <div class="o_ocd_sand_card">
                        <t t-if="pass_end">
                            <div class="o_ocd_live_card_head">
                                <span>
                                    <b>Pass until <t t-out="pass_end"/></b>
                                    <small>Reminder on WhatsApp <t t-out="reminder_days"/> days before the end</small>
                                </span>
                                <span class="o_ocd_badge_ok">Active</span>
                            </div>
                            <a t-if="listing" t-attf-href="/lives/statut/#{listing.id}" class="o_ocd_button">
                                <span class="o_ocd_live_dot" aria-hidden="true"/>
                                See where my link is
                            </a>
                            <a t-else="" href="/lives/envoyer" class="o_ocd_button">
                                <span class="o_ocd_live_dot" aria-hidden="true"/>
                                Send the link of my live
                            </a>
                        </t>
                        <t t-else="">
                            <div class="o_ocd_live_card_head">
                                <span>
                                    <b>No pass</b>
                                    <small>Show your live to your country during 30 days.</small>
                                </span>
                            </div>
                            <a href="/lives/pass" class="o_ocd_button">Take the pass</a>
                        </t>
                    </div>

                    <h2 class="o_ocd_section">My card in the lives</h2>
                    <div class="o_ocd_sand_card">
                        <div class="o_ocd_live_card_head">
                            <span>
                                <b t-out="card_shown"/>
                                <small>Shown in the feed of the lives while you are live, before your next live and in your replays.</small>
                            </span>
                        </div>
                        <a href="/ocd/espace/moi/carte" class="o_ocd_button o_ocd_button_line">Change my card</a>
                    </div>

                    <div class="o_ocd_space_shop"/>

                    <form action="/ocd/espace/moi/whatsapp" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <t t-set="whatsapp_on" t-value="vendor._ocd_whatsapp_consent()"/>
                        <button type="submit" class="o_ocd_toggle" role="switch"
                                t-att-aria-checked="'true' if whatsapp_on else 'false'">
                            <span class="o_ocd_toggle_box" aria-hidden="true">
                                <t t-if="whatsapp_on" t-call="ocd_live.icon" icon.f="check"/>
                            </span>
                            <span t-if="whatsapp_on">Tickets and reminders on WhatsApp: on</span>
                            <span t-else="">Tickets and reminders on WhatsApp: off</span>
                        </button>
                    </form>

                    <a href="/ocd" class="o_ocd_cta">Book another live</a>
                </main>
            </div>
        </t>
    </template>

</odoo>
