<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_account_view_form_calls" model="ir.ui.view">
        <field name="name">whatsapp.account.form.calls</field>
        <field name="model">whatsapp.account</field>
        <field name="inherit_id" ref="whatsapp_cloud.whatsapp_account_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_call_send_settings" type="object" string="Send the Calls to Meta"
                        invisible="not id or (not call_enabled and call_meta_state == 'disabled')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_calls" type="object" class="oe_stat_button" icon="fa-phone"
                        invisible="not call_enabled and not call_count">
                    <field name="call_count" widget="statinfo" string="Calls"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='team']" position="after">
                <page string="Calls" name="calls">
                    <div class="alert alert-warning" role="alert" invisible="not call_limit_warning">
                        <field name="call_limit_warning"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not call_hours_warning">
                        <field name="call_hours_warning"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="call_meta_state != 'pending'">
                        The settings changed: send them to Meta (button at the top).
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="call_meta_state not in ('error', 'restricted')">
                        <field name="call_meta_message"/>
                    </div>
                    <group>
                        <group string="At Meta">
                            <field name="call_enabled"/>
                            <field name="call_icon_visibility" invisible="not call_enabled"/>
                            <field name="call_use_hours" invisible="not call_enabled"/>
                            <field name="call_callback_permission" invisible="not call_enabled"/>
                            <field name="call_srtp" invisible="not call_enabled"/>
                        </group>
                        <group string="Waiting">
                            <field name="call_max_wait" invisible="not call_enabled"/>
                            <field name="call_voicemail" invisible="not call_enabled"/>
                            <field name="call_hold_voice_every" invisible="not call_enabled"/>
                            <field name="call_recording" invisible="not call_enabled"/>
                            <field name="call_recording_days" invisible="not call_enabled or not call_recording"/>
                        </group>
                        <group string="State">
                            <field name="call_meta_state" widget="badge"
                                   decoration-success="call_meta_state == 'ok'"
                                   decoration-info="call_meta_state == 'pending'"
                                   decoration-danger="call_meta_state in ('error', 'restricted')"/>
                            <field name="call_meta_date"/>
                            <field name="call_sip_password" password="True" groups="base.group_system"/>
                            <button name="action_call_read_settings" type="object" string="Read the State at Meta"
                                    class="btn-link ps-0" invisible="not id"/>
                        </group>
                    </group>
                    <group string="Thresholds to Open the Calls to All (14 days)" invisible="not call_stats_count">
                        <group>
                            <field name="call_stats_count"/>
                            <field name="call_stats_cut_rate" widget="percentage"
                                   decoration-success="call_stats_cut_rate &lt; 0.02"
                                   decoration-danger="call_stats_cut_rate &gt;= 0.02"/>
                            <field name="call_stats_voicemail_rate" widget="percentage"
                                   decoration-success="call_stats_voicemail_rate &lt; 0.05"
                                   decoration-danger="call_stats_voicemail_rate &gt;= 0.05"/>
                            <field name="call_stats_wait"
                                   decoration-success="call_stats_wait &lt; 60"
                                   decoration-danger="call_stats_wait &gt;= 60"/>
                        </group>
                        <group>
                            <field name="call_stats_ok"/>
                            <div class="text-muted" colspan="2">
                                Under 2 % of calls cut, under 5 % of voicemail while an agent was free, an average wait under 1 minute during the call hours.
                            </div>
                        </group>
                    </group>
                    <group string="Messages of the Calls" invisible="not call_enabled">
                        <div class="text-muted" colspan="2">
                            What the customers who call this number hear, in MP3 or WAV: the call server takes them within a minute, without stopping the calls. Without a message here: the one of the folder sounds of the call server, else a short tone (nothing for the voice while waiting).
                        </div>
                        <field name="call_sound_ids" colspan="2" nolabel="1">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="kind" width="[160px]"/>
                                <field name="name" width="[200px]"/>
                                <field name="file_name" width="[110px,180px]"/>
                                <field name="too_long" column_invisible="1"/>
                                <field name="duration" decoration-warning="too_long"/>
                                <field name="server_state" widget="badge" width="[190px]"
                                       decoration-success="server_state == 'ok'"
                                       decoration-info="server_state == 'pending'"
                                       decoration-danger="server_state == 'error'"/>
                                <field name="server_message" optional="hide"/>
                                <button name="action_listen" type="object" string="Listen" class="btn-link"/>
                            </list>
                            <form>
                                <div class="alert alert-warning" role="alert" invisible="not too_long">
                                    Longer than recommended: the customer waits while it plays. Say it more briefly, or keep one language.
                                </div>
                                <group>
                                    <group>
                                        <field name="kind"/>
                                        <field name="duration_advice" invisible="not duration_advice"/>
                                        <field name="too_long" invisible="1"/>
                                        <field name="file" filename="file_name"
                                               options="{'accepted_file_extensions': '.mp3,.wav'}"/>
                                        <field name="file_name" invisible="1"/>
                                        <field name="sequence" invisible="kind not in ('voix', 'musique')"/>
                                    </group>
                                    <group>
                                        <field name="server_state"/>
                                        <field name="server_message" invisible="not server_message"/>
                                        <field name="duration" decoration-warning="too_long"/>
                                        <field name="size"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="name" placeholder="Choose the message: a text in French and in English is proposed."/>
                                </group>
                            </form>
                        </field>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not call_budget_warning">
                        <field name="call_budget_warning"/>
                    </div>
                    <group string="Cost of the Calls of the Company" invisible="not call_enabled">
                        <group>
                            <field name="call_currency_id"/>
                            <field name="call_default_rate"/>
                            <field name="call_max_outbound_minutes"/>
                            <field name="call_monthly_budget"/>
                        </group>
                        <group>
                            <field name="call_month_count"/>
                            <field name="call_month_cost"/>
                            <button name="action_call_costs" type="object" string="Cost Report"
                                    class="btn-link ps-0" invisible="not id"/>
                            <button name="action_call_recompute_costs" type="object"
                                    string="Apply the Rates to the Calls of the Month" class="btn-link ps-0"
                                    invisible="not id"/>
                        </group>
                        <field name="call_rate_ids" colspan="2" nolabel="1">
                            <list editable="bottom">
                                <field name="country_id"/>
                                <field name="phone_code"/>
                                <field name="price_per_minute"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                        <div class="text-muted mb-3" colspan="2">
                            Meta bills the calls of the company by pulses of 6 seconds at the rate of the country called (its rate card, in dollars, changes every quarter; the rates go down with the minutes of the month): the cost here is the most it costs. The calls of the customers are free. Meta refuses the calls to the United States, Canada, Egypt, Vietnam and Nigeria: Odoo does not place them.
                        </div>
                    </group>
                    <div class="text-muted">
                        The calls ring for the agents of the Team tab who take the calls (phone of the top bar). The address of the call server is in Settings &gt; WhatsApp &gt; Calls. In the webhook of the Meta app, also subscribe to the field calls: Odoo then sees the calls that the call server did not take.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
