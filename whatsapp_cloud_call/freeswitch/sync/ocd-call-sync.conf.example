# /etc/ocd-call-sync.conf (chmod 600, owner freeswitch)
[ocd]
# address of Odoo, as the team opens it
odoo_url = https://odoo.example.com
# Settings > WhatsApp > Calls > Key of the Call Server
token = CHANGE-ME
# password of the event socket of FreeSWITCH (ocd_esl_password in vars_ocd.xml)
esl_password = CHANGE-ME
# every 30 seconds
interval = 30
