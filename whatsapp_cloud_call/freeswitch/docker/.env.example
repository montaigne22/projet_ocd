# The settings of the call server (docker compose reads .env; chmod 600 .env).

# name of the call server, as in Odoo (Settings > WhatsApp > Calls) and in its certificate
OCD_SIP_DOMAIN=calls.example.com
# public IP of the server (fixed)
EXTERNAL_IP=203.0.113.10

# address of Odoo, as the team opens it, and the key of the call server (Settings > WhatsApp >
# Calls > Key of the Call Server)
OCD_ODOO_URL=https://odoo.example.com
OCD_TOKEN=CHANGE-ME

# password of the event socket of FreeSWITCH (127.0.0.1 only): a long random value
# (openssl rand -hex 24)
OCD_ESL_PASSWORD=CHANGE-ME

# secret of the TURN relay: the same in Odoo (Settings > WhatsApp > Calls > Secret of the TURN
# Relay) (openssl rand -hex 32)
TURN_SECRET=CHANGE-ME

# encryption of the voice with Meta: SDES (as the setting of the account in Odoo) or DTLS
OCD_SRTP=SDES

# folders of the certificate (written by ocd-freeswitch-certs.sh) and of the recorded messages
OCD_CERTS_DIR=./data/certs
OCD_SOUNDS_DIR=./sounds
