# The settings of the call server. Copy to .env (cp .env.example .env && chmod 600 .env), fill in,
# then: docker compose up -d. The .env stays on the server, never in the repository.
# Each line is explained in ../README.md ("Le fichier .env, ligne par ligne").

# Name of the call server: Meta sends the calls to it, the agents connect to it, its certificate is
# for this name. A DNS record A towards EXTERNAL_IP. ODOO: the same in Settings > WhatsApp > Calls >
# Address of the Call Server.
OCD_SIP_DOMAIN=calls.example.com

# Public fixed IPv4 of the server (dashboard of the host).
EXTERNAL_IP=203.0.113.10

# Address of Odoo as the team opens it, without /odoo at the end; reachable in HTTPS from this server.
OCD_ODOO_URL=https://odoo.example.com

# Key of the call server. ODOO: Settings > WhatsApp > Calls > Key of the Call Server (copy button).
# After "New Key" in Odoo: copy it here again, then docker compose up -d.
OCD_TOKEN=CHANGE-ME

# Password between FreeSWITCH and ocd-call-sync, on this server only (127.0.0.1). To make up:
# openssl rand -hex 24. Nowhere else, not in Odoo.
OCD_ESL_PASSWORD=CHANGE-ME

# Secret of the TURN relay (credentials of 12 hours for the agents). To make up: openssl rand -hex 32.
# ODOO: the same in Settings > WhatsApp > Calls > Secret of the TURN Relay.
TURN_SECRET=CHANGE-ME

# Port of the TURN relay over TLS: 443 (passes almost every firewall), or 5349 when another program
# (nginx) holds the port 443 on this server. ODOO: the same in Settings > WhatsApp > Calls > Port of
# the TURN Relay (TLS).
TURN_TLS_PORT=443

# Encryption of the voice with Meta: SDES (recommended) or DTLS. The same as in Odoo, WhatsApp
# account, Calls tab, "Encryption of the Voice".
OCD_SRTP=SDES

# Folder of the certificate (written by tls/ocd-freeswitch-certs.sh) and of the recorded messages
# (accueil.wav, reconnexion.wav, messagerie.wav, indisponible.wav). Keep these values.
OCD_CERTS_DIR=./data/certs
OCD_SOUNDS_DIR=./sounds

# Optional, only when needed:
# OCD_SYNC_INTERVAL=30               seconds between two copies of the agents
# OCD_AGENT_CANDIDATE_ACL=wan_v4.auto  addresses of the agents accepted (localnet.auto: a test on the
#                                    same network only)
