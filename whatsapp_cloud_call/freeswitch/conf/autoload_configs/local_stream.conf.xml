<configuration name="local_stream.conf" description="stream files from local dir">
  <!-- OCD: the music while the customer waits (local_stream://moh) -->
  <directory name="moh" path="$${sounds_dir}/music/16000">
    <param name="rate" value="16000"/>
    <param name="shuffle" value="true"/>
    <param name="channels" value="1"/>
    <param name="interval" value="20"/>
    <param name="timer-name" value="soft"/>
  </directory>
  <!-- the hold stream of each number (local_stream://ocd_<phone number ID>): its music and its
       voices given in Odoo, written by ocd-call-sync and applied without restarting -->
  <X-PRE-PROCESS cmd="include" data="/var/lib/freeswitch/ocd/local_stream_ocd*.xml"/>
</configuration>
