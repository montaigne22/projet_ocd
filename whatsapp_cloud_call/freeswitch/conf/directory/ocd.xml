<include>
  <!-- OCD: the users of the call server, written by ocd-call-sync in directory/ocd/:
       agents.xml (the agents of Odoo) and meta.xml (the numbers of Meta, with their SIP
       password) -->
  <domain name="$${ocd_sip_domain}">
    <params>
      <!-- an agent rings on all their open pages (profile ocd_agents only) -->
      <param name="dial-string" value="{^^:sip_invite_domain=${dialed_domain}:presence_id=${dialed_user}@${dialed_domain}}${sofia_contact(ocd_agents/${dialed_user}@${dialed_domain})}"/>
      <param name="allow-empty-password" value="false"/>
    </params>
    <groups>
      <group name="ocd">
        <users>
          <X-PRE-PROCESS cmd="include" data="ocd/*.xml"/>
        </users>
      </group>
    </groups>
  </domain>
</include>
