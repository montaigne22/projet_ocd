<include>
  <!-- OCD: WhatsApp calls. Included at the end of vars.xml (an include of vars_ocd.xml: see the
       README; no such line in a comment, FreeSWITCH runs them there too) -->

  <!-- name of the call server: the same as in Odoo (Settings > WhatsApp > Calls) and in its
       certificate (Meta checks it) -->
  <X-PRE-PROCESS cmd="set" data="ocd_sip_domain=calls.example.com"/>

  <!-- encryption of the voice with Meta: SDES (keys in the SDP, the setting "SDES" of the
       account in Odoo). For DTLS, set the account to DTLS and use instead:
       ocd_srtp=optional:AES_CM_128_HMAC_SHA1_80 with the variable media_webrtc=true in the
       dialplan (not tried yet with Meta) -->
  <X-PRE-PROCESS cmd="set" data="ocd_srtp=mandatory:AES_CM_128_HMAC_SHA1_80:AES_CM_128_HMAC_SHA1_32"/>

  <!-- where the calls of the company go: the SIP server of Meta (TLS, port 5061) -->
  <X-PRE-PROCESS cmd="set" data="ocd_meta_sip=wa.meta.vc"/>

  <!-- password of the event socket (127.0.0.1:8021), the same in /etc/ocd-call-sync.conf -->
  <X-PRE-PROCESS cmd="set" data="ocd_esl_password=CHANGE-ME"/>

  <!-- ICE candidates of the agents accepted: their public addresses (and the TURN relay) -->
  <X-PRE-PROCESS cmd="set" data="ocd_agent_candidate_acl=wan_v4.auto"/>

  <!-- address of Odoo and key of the call server (written by ocd-call-sync), and in Docker the
       settings of the environment (written at the start of the container): they replace the
       values above -->
  <X-PRE-PROCESS cmd="include" data="/var/lib/freeswitch/ocd/vars*.xml"/>
</include>
