<!-- OCD: the agents, from their browser in Odoo (WebRTC). SIP over WebSocket secured (WSS),
     port 7443; the voice in DTLS-SRTP with Opus. Each agent signs in with the password given
     by Odoo (copied by ocd-call-sync into directory/ocd/agents.xml). -->
<profile name="ocd_agents">
  <aliases>
  </aliases>
  <gateways>
  </gateways>
  <domains>
    <domain name="$${ocd_sip_domain}" alias="false" parse="false"/>
  </domains>
  <settings>
    <param name="debug" value="0"/>
    <param name="sip-trace" value="no"/>
    <param name="context" value="ocd_agents"/>
    <param name="dialplan" value="XML"/>
    <param name="user-agent-string" value="OCD"/>

    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="rtp-ip" value="$${local_ip_v4}"/>
    <param name="ext-sip-ip" value="$${external_sip_ip}"/>
    <param name="ext-rtp-ip" value="$${external_rtp_ip}"/>
    <!-- plain SIP port, closed by the firewall: WebSocket only -->
    <param name="sip-port" value="5090"/>
    <param name="wss-binding" value=":7443"/>
    <param name="tls-cert-dir" value="$${certs_dir}"/>
    <param name="apply-candidate-acl" value="$${ocd_agent_candidate_acl}"/>

    <param name="auth-calls" value="true"/>
    <param name="accept-blind-reg" value="false"/>
    <param name="accept-blind-auth" value="false"/>
    <param name="challenge-realm" value="$${ocd_sip_domain}"/>
    <param name="force-register-domain" value="$${ocd_sip_domain}"/>
    <param name="force-register-db-domain" value="$${ocd_sip_domain}"/>
    <param name="force-subscription-domain" value="$${ocd_sip_domain}"/>
    <!-- several open pages of the same agent ring together -->
    <param name="max-registrations-per-extension" value="5"/>
    <param name="disable-transfer" value="true"/>
    <param name="manage-presence" value="false"/>
    <param name="enable-timer" value="false"/>

    <param name="inbound-codec-prefs" value="OPUS"/>
    <param name="outbound-codec-prefs" value="OPUS"/>
    <!-- an agent cut off is noticed after 10 seconds without voice (media_timeout of the leg) -->
    <param name="rtp-timeout-sec" value="15"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>
    <param name="local-network-acl" value="localnet.auto"/>
  </settings>
</profile>
