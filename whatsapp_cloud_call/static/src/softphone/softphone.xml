<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="whatsapp_cloud_call.SoftphoneSystray">
        <div class="o_whatsapp_softphone_systray" t-if="this.softphone.enabled">
            <Dropdown position="'bottom-end'">
                <button class="o_nav_entry position-relative" t-att-title="this.statusText">
                    <i class="oi oi-fw" t-att-data-icon="this.softphone.available ? 'phone' : 'phone_paused'" role="img"
                       aria-label="WhatsApp calls"/>
                    <span t-attf-class="o_whatsapp_softphone_dot position-absolute rounded-circle {{ this.dotClass }}"/>
                </button>
                <t t-set-slot="content">
                    <div class="o_whatsapp_softphone_menu px-3 py-2">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="o_whatsapp_softphone_available"
                                   t-att-checked="this.softphone.available" t-on-change="() => this.toggle()"/>
                            <label class="form-check-label fw-bold" for="o_whatsapp_softphone_available">
                                I take the WhatsApp calls
                            </label>
                        </div>
                        <div class="small text-muted" t-out="this.statusText"/>
                        <div class="small text-danger mt-2" t-if="this.softphone.available and this.softphone.microphone === 'denied'">
                            The browser refuses the microphone: the calls cannot be answered. Allow it for this site (icon at the left of the address), then reload the page.
                        </div>
                        <div class="small text-warning mt-2" t-if="this.softphone.available and this.softphone.microphone === 'prompt'">
                            Allow the microphone when the browser asks (at the top, at the left of the address).
                        </div>
                        <div class="small text-warning mt-2" t-if="this.softphone.needsGesture">
                            Click anywhere on the page to allow the ringing.
                        </div>
                        <div class="small text-muted mt-2">
                            Keep this page open: the calls ring while it is open. Your colleagues get the call if you do not answer.
                        </div>
                        <div class="small text-muted mt-1">Phone <t t-out="this.softphone.version"/></div>
                    </div>
                </t>
            </Dropdown>
        </div>
    </t>

    <t t-name="whatsapp_cloud_call.SoftphonePanel">
        <div class="o_whatsapp_softphone_panel card shadow-lg" t-if="this.softphone.incoming or this.softphone.active or this.softphone.message">
            <div class="card-body p-3" t-if="this.call">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="oi oi-fw text-success" data-icon="phone" t-if="this.softphone.incoming"/>
                    <i class="oi oi-fw text-success" data-icon="phone_in_talk" t-else=""/>
                    <span class="small text-muted" t-if="this.softphone.incoming">WhatsApp call</span>
                    <span class="small text-warning" t-elif="this.softphone.active.connecting">Connecting...</span>
                    <span class="small text-muted" t-else="">In call · <t t-out="this.duration"/></span>
                    <span class="small text-muted ms-auto" t-out="this.call.account"/>
                </div>
                <div class="fw-bold fs-5 text-truncate" t-out="this.call.name or this.call.number"/>
                <div class="small text-muted" t-if="this.call.name and this.call.number" t-out="this.call.number"/>
                <div class="small text-muted" t-if="this.call.previousCalls">
                    <t t-out="this.call.previousCalls"/> previous call(s)
                </div>
                <div class="small text-warning mt-1" t-if="this.softphone.active and this.softphone.active.lost">
                    Connection unstable...
                </div>
                <div class="small text-warning mt-1" t-if="this.softphone.active and this.softphone.active.askingMicrophone">
                    The browser asks for the microphone: click Allow (at the top, at the left of the address).
                </div>
                <button class="btn btn-link btn-sm px-0" t-if="this.call.channelId"
                        t-on-click="() => this.softphone.openConversation(this.call.channelId)">
                    Open the conversation
                </button>
                <div class="d-flex gap-2 mt-2" t-if="this.softphone.incoming">
                    <button class="btn btn-success flex-grow-1" t-on-click="() => this.softphone.answer()">
                        <i class="oi oi-fw" data-icon="phone"/> Answer
                    </button>
                    <button class="btn btn-danger flex-grow-1" t-on-click="() => this.softphone.decline()">
                        <i class="oi oi-fw" data-icon="close"/> Decline
                    </button>
                </div>
                <div class="d-flex gap-2 mt-2" t-else="">
                    <button class="btn btn-secondary flex-grow-1" t-on-click="() => this.softphone.toggleMute()">
                        <i class="oi oi-fw" t-att-data-icon="this.softphone.active.muted ? 'mic_off' : 'mic'"/>
                        <t t-if="this.softphone.active.muted">Microphone off</t>
                        <t t-else="">Mute</t>
                    </button>
                    <button class="btn btn-danger flex-grow-1" t-on-click="() => this.softphone.hangup()">
                        <i class="oi oi-fw" data-icon="close"/> Hang up
                    </button>
                </div>
            </div>
            <div class="card-body p-3 d-flex align-items-start gap-2" t-elif="this.softphone.message">
                <span class="small flex-grow-1" t-out="this.softphone.message"/>
                <button class="btn-close" aria-label="Close" t-on-click="() => this.dismissMessage()"/>
            </div>
        </div>
    </t>

</templates>
